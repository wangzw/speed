<!--
  coding-flow 看板骨架。render.py 渲染时会把下面表格里的 CODING-FLOW-ISSUES 标记替换成
  真实的 Issue 表格行，把生成时间标记替换成实际时间——具体标记字符串见 render.py 源码，
  这里不直接写出来，避免这段说明文字本身被当成模板变量误替换（早期版本踩过这个坑：
  这条注释里如果原样写出标记的字面文本，会被 render.py 的字符串替换一并命中）。
  渲染发生在 dashboard-render.yml workflow 里，见 SKILL.md「看板：调度状态可视化」。
-->
<!DOCTYPE html>
<html lang="zh">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>coding-flow 看板</title>
  <style>
    :root {
      color-scheme: light dark;
      --border: #d0d7de;
      --muted: #57606a;
      --bg-subtle: #f6f8fa;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      margin: 2rem auto;
      max-width: 960px;
      padding: 0 1rem;
      line-height: 1.5;
    }
    h1 { font-size: 1.4rem; margin-bottom: 0.25rem; }
    .meta { color: var(--muted); font-size: 0.85rem; margin-bottom: 1.5rem; }
    table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
    th, td {
      border-bottom: 1px solid var(--border);
      padding: 0.5rem 0.6rem;
      text-align: left;
      vertical-align: top;
    }
    th { background: var(--bg-subtle); font-weight: 600; }
    .phase { font-family: ui-monospace, monospace; }
    .status { font-family: ui-monospace, monospace; }
    .status-awaiting-human { color: #9a6700; font-weight: 600; }
    .status-blocked { color: #57606a; }
    .empty { text-align: center; color: var(--muted); padding: 2rem 0; }
  </style>
</head>
<body>
  <h1>coding-flow 看板</h1>
  <p class="meta">最后更新：{{GENERATED_AT}}（由 Scheduler 派发 dashboard-render workflow 自动生成）</p>
  <table>
    <thead>
      <tr>
        <th>Issue</th>
        <th>标题</th>
        <th>Phase</th>
        <th>Status</th>
        <th>Blocked by</th>
        <th>最新结论/待办</th>
        <th>更新时间</th>
      </tr>
    </thead>
    <tbody>
      <!-- CODING_FLOW_ISSUES -->
    </tbody>
  </table>
</body>
</html>
