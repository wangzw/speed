{
  "openapi": "3.1.0",
  "info": {"title": "authn invite", "version": "1.0.0"},
  "paths": {
    "/auth/admin/tenants/{tenant}/invitations": {
      "post": {
        "operationId": "authn.invite.issue",
        "summary": "Issue an invitation to an address in a tenant",
        "parameters": [
          {"name": "tenant", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "properties": {
                  "email": {"type": "string"},
                  "expires_at": {"type": "string", "format": "date-time"}
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The invitation view together with its one-time token",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AuthnInviteIssued"}}}
          },
          "400": {"description": "The body could not be read, or the address is malformed"},
          "401": {"description": "No usable credential"},
          "403": {"description": "The caller may not manage memberships in the tenant"},
          "503": {"description": "A dependency could not answer"}
        }
      },
      "get": {
        "operationId": "authn.invite.list",
        "summary": "One page of a tenant's invitations",
        "parameters": [
          {"name": "tenant", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer"}},
          {"name": "after", "in": "query", "required": false, "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {
            "description": "The page of invitations and the next cursor",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AuthnInvitePage"}}}
          },
          "400": {"description": "The page query could not be read"},
          "401": {"description": "No usable credential"},
          "403": {"description": "The caller may not manage memberships in the tenant"},
          "503": {"description": "A dependency could not answer"}
        }
      }
    },
    "/auth/admin/tenants/{tenant}/invitations/{id}": {
      "delete": {
        "operationId": "authn.invite.revoke",
        "summary": "Revoke a pending invitation",
        "parameters": [
          {"name": "tenant", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "204": {"description": "The invitation was revoked"},
          "400": {"description": "The invitation identifier is missing"},
          "401": {"description": "No usable credential"},
          "403": {"description": "The caller may not manage memberships in the tenant"},
          "404": {"description": "No such invitation"},
          "409": {"description": "The invitation was already accepted"},
          "503": {"description": "A dependency could not answer"}
        }
      }
    },
    "/auth/invitations/{token}": {
      "get": {
        "operationId": "authn.invite.acceptView",
        "summary": "Read the invitation a token points to",
        "parameters": [
          {"name": "token", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {
            "description": "The invitation view",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AuthnInviteView"}}}
          },
          "404": {"description": "No such invitation"},
          "409": {"description": "The invitation is expired, revoked or already accepted"},
          "503": {"description": "A dependency could not answer"}
        }
      },
      "post": {
        "operationId": "authn.invite.accept",
        "summary": "Redeem an invitation, creating the account when the address has none",
        "parameters": [
          {"name": "token", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "display_name": {"type": "string"},
                  "password": {"type": "string"}
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The membership the acceptance wrote",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AuthnInviteAccept"}}}
          },
          "400": {"description": "The body or an argument is malformed"},
          "404": {"description": "No such invitation"},
          "409": {"description": "The invitation is expired, revoked or already accepted"},
          "503": {"description": "A dependency could not answer"}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthnInviteInvitation": {
        "type": "object",
        "required": ["id", "tenant", "email", "status", "invited_by", "expires_at", "accepted_at", "created_at"],
        "properties": {
          "id": {"type": "string"},
          "tenant": {"type": "string"},
          "email": {"type": "string", "description": "The normalized address"},
          "status": {"type": "string", "enum": ["pending", "accepted", "revoked"]},
          "invited_by": {"type": "string"},
          "expires_at": {"type": "string", "format": "date-time"},
          "accepted_at": {"type": "string", "format": "date-time", "description": "The zero instant 0001-01-01T00:00:00Z when the invitation has not been accepted"},
          "created_at": {"type": "string", "format": "date-time"}
        }
      },
      "AuthnInviteIssued": {
        "type": "object",
        "required": ["invitation", "token"],
        "properties": {
          "invitation": {"$ref": "#/components/schemas/AuthnInviteInvitation"},
          "token": {"type": "string", "description": "The acceptance token, handed out once"}
        }
      },
      "AuthnInviteView": {
        "type": "object",
        "required": ["invitation"],
        "properties": {
          "invitation": {"$ref": "#/components/schemas/AuthnInviteInvitation"}
        }
      },
      "AuthnInvitePage": {
        "type": "object",
        "required": ["invitations", "next_cursor"],
        "properties": {
          "invitations": {"type": "array", "items": {"$ref": "#/components/schemas/AuthnInviteInvitation"}},
          "next_cursor": {"type": "string", "description": "The cursor of the next page, empty on the last page"}
        }
      },
      "AuthnInviteAccept": {
        "type": "object",
        "required": ["account", "tenant", "active", "source", "sso_exempt"],
        "properties": {
          "account": {"type": "string"},
          "tenant": {"type": "string"},
          "active": {"type": "boolean"},
          "source": {"type": "string"},
          "sso_exempt": {"type": "boolean"}
        }
      }
    }
  }
}
