{
  "openapi": "3.1.0",
  "info": {"title": "authn token", "version": "1.0.0"},
  "paths": {
    "/auth/jwks.json": {
      "get": {
        "operationId": "authn.token.jwks",
        "summary": "The public keys that verify the issued tokens",
        "responses": {
          "200": {
            "description": "The JWK set of the startup key set",
            "content": {"application/jwk-set+json": {"schema": {"$ref": "#/components/schemas/AuthnTokenJWKS"}}}
          },
          "503": {"description": "The key set could not be written"}
        }
      }
    },
    "/auth/token": {
      "post": {
        "operationId": "authn.token.issue",
        "summary": "Exchange a client credential or a refresh token for an access token",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "grant_type": {"type": "string", "enum": ["client_credentials", "refresh_token"]},
                  "refresh_token": {"type": "string"},
                  "client_id": {"type": "string"},
                  "client_secret": {"type": "string"}
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The access token, and a refresh token for the refresh_token grant",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AuthnTokenResponse"}}}
          },
          "400": {"description": "invalid_request / unsupported_grant_type / invalid_grant"},
          "401": {"description": "invalid_client, in the RFC 6749 §5.2 body"},
          "503": {"description": "temporarily_unavailable"}
        }
      }
    },
    "/auth/token/revoke": {
      "post": {
        "operationId": "authn.token.revoke",
        "summary": "Revoke a refresh token",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {"token": {"type": "string"}}
              }
            }
          }
        },
        "responses": {
          "200": {"description": "Answered whatever the token's state, with an empty body"},
          "503": {"description": "temporarily_unavailable — the token store could not answer"}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthnTokenResponse": {
        "type": "object",
        "required": ["access_token", "token_type", "expires_in"],
        "properties": {
          "access_token": {"type": "string"},
          "token_type": {"type": "string", "description": "Always Bearer"},
          "expires_in": {"type": "integer", "description": "The access token's remaining lifetime in whole seconds"},
          "refresh_token": {"type": "string", "description": "Present only for the refresh_token grant"}
        }
      },
      "AuthnTokenJWKS": {
        "type": "object",
        "required": ["keys"],
        "properties": {
          "keys": {"type": "array", "items": {"$ref": "#/components/schemas/AuthnTokenJWK"}}
        }
      },
      "AuthnTokenJWK": {
        "type": "object",
        "additionalProperties": true,
        "required": ["kty", "kid"],
        "properties": {
          "kty": {"type": "string", "description": "The key type, for example EC or RSA"},
          "use": {"type": "string", "description": "The key use, signature"},
          "kid": {"type": "string", "description": "The RFC 7638 thumbprint of the public key"},
          "alg": {"type": "string", "description": "The signature algorithm the key signs and verifies with"},
          "crv": {"type": "string"},
          "x": {"type": "string"},
          "y": {"type": "string"},
          "n": {"type": "string"},
          "e": {"type": "string"}
        }
      }
    }
  }
}
