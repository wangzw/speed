    "/auth/admin/sso/providers/{id}/metadata/refresh": {
      "post": {
        "operationId": "authn.admin.sso.providers.refreshMetadata",
        "summary": "Refresh an SSO provider's metadata",
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {
            "description": "The refreshed provider",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AuthnAdminProviderEnvelope"}}}
          },
          "400": {"description": "The body could not be read"},
          "401": {"description": "No usable credential"},
          "403": {"description": "The caller is impersonating or may not refresh metadata"},
          "404": {"description": "No such provider"},
          "503": {"description": "A dependency could not answer"}
        }
      }
    },
    "/auth/admin/impersonations": {
      "get": {
        "operationId": "authn.admin.impersonations.list",
        "summary": "List impersonation records, one page at a time",
        "parameters": [
          {"name": "tenant", "in": "query", "required": true, "schema": {"type": "string"}},
          {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer"}},
          {"name": "after", "in": "query", "required": false, "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {
            "description": "The page of records and the next cursor",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AuthnAdminImpersonationList"}}}
          },
          "400": {"description": "The page query could not be read"},
          "401": {"description": "No usable credential"},
          "403": {"description": "The caller is impersonating or may not read records"},
          "503": {"description": "A dependency could not answer"}
        }
      }
    },
    "/auth/admin/impersonations/{id}": {
      "delete": {
        "operationId": "authn.admin.impersonations.revoke",
        "summary": "Revoke an impersonation record",
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "204": {"description": "The record was revoked"},
          "401": {"description": "No usable credential"},
          "403": {"description": "The caller is impersonating or may not revoke records"},
          "404": {"description": "No such record"},
          "503": {"description": "A dependency could not answer"}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthnAdminAccount": {
        "type": "object",
        "required": ["id", "kind", "status", "display_name", "mfa_required", "protected", "password_set", "created_at"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"type": "string", "enum": ["user", "service"]},
          "status": {"type": "string", "enum": ["disabled", "active", "deleted"]},
          "display_name": {"type": "string"},
          "mfa_required": {"type": "boolean"},
          "protected": {"type": "boolean"},
          "password_set": {"type": "boolean"},
          "attributes": {"type": "object", "additionalProperties": {"type": "string"}, "description": "Absent when the account carries no attribute set"},
          "created_at": {"type": "string", "format": "date-time"}
        }
      },
      "AuthnAdminAccountEnvelope": {
        "type": "object",
        "required": ["account"],
        "properties": {"account": {"$ref": "#/components/schemas/AuthnAdminAccount"}}
      },
      "AuthnAdminAccountList": {
        "type": "object",
        "required": ["accounts", "next_cursor"],
        "properties": {
          "accounts": {"type": "array", "items": {"$ref": "#/components/schemas/AuthnAdminAccount"}},
          "next_cursor": {"type": "string", "description": "The cursor of the next page, empty on the last page"}
        }
      },
      "AuthnAdminFactor": {
        "type": "object",
        "required": ["kind", "label", "status"],
        "properties": {
          "kind": {"type": "string"},
          "label": {"type": "string"},
          "status": {"type": "string", "enum": ["pending", "active", "disabled"]}
        }
      },
      "AuthnAdminFactorList": {
        "type": "object",
        "required": ["factors"],
        "properties": {"factors": {"type": "array", "items": {"$ref": "#/components/schemas/AuthnAdminFactor"}}}
      },
      "AuthnAdminRemoved": {
        "type": "object",
        "required": ["removed"],
        "properties": {"removed": {"type": "integer", "description": "The number of factors removed"}}
      },
      "AuthnAdminSession": {
        "type": "object",
        "required": ["id", "kind", "assurance", "auth_time", "created_at", "last_seen_at", "expires_at", "revoked"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"type": "string"},
          "assurance": {"type": "integer", "description": "0 none, 1 single factor, 2 multi-factor"},
          "auth_time": {"type": "string", "format": "date-time"},
          "impersonation_id": {"type": "string", "description": "Absent unless the session carries an impersonation"},
          "created_at": {"type": "string", "format": "date-time"},
          "last_seen_at": {"type": "string", "format": "date-time"},
          "expires_at": {"type": "string", "format": "date-time"},
          "revoked": {"type": "boolean"}
        }
      },
      "AuthnAdminSessionList": {
        "type": "object",
        "required": ["sessions"],
        "properties": {"sessions": {"type": "array", "items": {"$ref": "#/components/schemas/AuthnAdminSession"}}}
      },
      "AuthnAdminRevoked": {
        "type": "object",
        "required": ["revoked"],
        "properties": {"revoked": {"type": "integer", "description": "The number of sessions revoked"}}
      },
      "AuthnAdminSecret": {
        "type": "object",
        "required": ["id", "label", "expires_at", "revoked"],
        "properties": {
          "id": {"type": "string"},
          "label": {"type": "string"},
          "expires_at": {"type": "string", "format": "date-time"},
          "revoked": {"type": "boolean"}
        }
      },
      "AuthnAdminSecretList": {
        "type": "object",
        "required": ["secrets"],
        "properties": {"secrets": {"type": "array", "items": {"$ref": "#/components/schemas/AuthnAdminSecret"}}}
      },
      "AuthnAdminSecretCreated": {
        "type": "object",
        "required": ["id", "label", "secret", "expires_at"],
        "properties": {
          "id": {"type": "string"},
          "label": {"type": "string"},
          "secret": {"type": "string", "description": "The secret itself, handed out once and never again"},
          "expires_at": {"type": "string", "format": "date-time", "description": "The zero instant 0001-01-01T00:00:00Z when the request named no expiry"}
        }
      },
      "AuthnAdminMember": {
        "type": "object",
        "required": ["account", "tenant", "active", "sso_exempt", "source"],
        "properties": {
          "account": {"type": "string"},
          "tenant": {"type": "string"},
          "active": {"type": "boolean"},
          "sso_exempt": {"type": "boolean"},
          "source": {"type": "string"}
        }
      },
      "AuthnAdminMemberList": {
        "type": "object",
        "required": ["members"],
        "properties": {"members": {"type": "array", "items": {"$ref": "#/components/schemas/AuthnAdminMember"}}}
      },
      "AuthnAdminProvider": {
        "type": "object",
        "required": ["id", "tenant", "protocol", "name", "enabled", "provisioning", "trust_idp_mfa", "allow_idp_initiated", "allow_sha1", "merge_existing", "version"],
        "properties": {
          "id": {"type": "string"},
          "tenant": {"type": "string"},
          "protocol": {"type": "string"},
          "name": {"type": "string"},
          "enabled": {"type": "boolean"},
          "provisioning": {"type": "string"},
          "trust_idp_mfa": {"type": "boolean"},
          "allow_idp_initiated": {"type": "boolean"},
          "allow_sha1": {"type": "boolean"},
          "merge_existing": {"type": "boolean"},
          "config": {"description": "The protocol's own configuration; absent when the provider carries none"},
          "version": {"type": "integer"},
          "warnings": {"type": "array", "items": {"type": "string"}, "description": "Absent when no setting loosens a default"}
        }
      },
      "AuthnAdminProviderEnvelope": {
        "type": "object",
        "required": ["provider"],
        "properties": {"provider": {"$ref": "#/components/schemas/AuthnAdminProvider"}}
      },
      "AuthnAdminProviderList": {
        "type": "object",
        "required": ["providers"],
        "properties": {"providers": {"type": "array", "items": {"$ref": "#/components/schemas/AuthnAdminProvider"}}}
      },
      "AuthnAdminVerifyToken": {
        "type": "object",
        "required": ["verify_token"],
        "properties": {"verify_token": {"type": "string", "description": "The token to publish in DNS"}}
      },
      "AuthnAdminImpersonation": {
        "type": "object",
        "required": ["id", "actor", "target", "tenant", "session_id", "started_at", "ends_at", "ended_at"],
        "properties": {
          "id": {"type": "string"},
          "actor": {"type": "string"},
          "target": {"type": "string"},
          "tenant": {"type": "string"},
          "session_id": {"type": "string"},
          "started_at": {"type": "string", "format": "date-time"},
          "ends_at": {"type": "string", "format": "date-time"},
          "ended_at": {"type": "string", "format": "date-time", "description": "The zero instant 0001-01-01T00:00:00Z while the record is still in force"},
          "end_reason": {"type": "string", "description": "Absent while the record is still in force"}
        }
      },
      "AuthnAdminImpersonationList": {
        "type": "object",
        "required": ["impersonations", "next_cursor"],
        "properties": {
          "impersonations": {"type": "array", "items": {"$ref": "#/components/schemas/AuthnAdminImpersonation"}},
          "next_cursor": {"type": "string", "description": "The cursor of the next page, empty on the last page"}
        }
      },
      "AuthnAdminAccountCreate": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": {"type": "string", "enum": ["user", "service"]},
          "display_name": {"type": "string"},
          "username": {"type": "string"},
          "email": {"type": "string"},
          "email_verified_via": {"type": "string", "enum": ["", "admin", "import-unverified"], "description": "How the administrator states the email came to be verified; empty or absent writes it unverified"},
          "phone": {"type": "string"},
          "phone_verified_via": {"type": "string", "enum": ["", "admin", "import-unverified"], "description": "How the administrator states the phone came to be verified; empty or absent writes it unverified"},
          "password": {"type": "string"},
          "attributes": {"type": "object", "additionalProperties": {"type": "string"}, "description": "Absent writes no attribute set"},
          "mfa_required": {"type": "boolean"}
        }
      },
      "AuthnAdminAccountPatch": {
        "type": "object",
        "properties": {
          "display_name": {"type": "string", "description": "Absent leaves the display name as it is"},
          "attributes": {"type": "object", "additionalProperties": {"type": "string"}, "description": "Absent leaves the attribute set as it is"},
          "protected": {"type": "boolean", "description": "Absent leaves the protected flag as it is"}
        }
      },
      "AuthnAdminAccountStatus": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {"type": "string", "enum": ["active", "disabled"], "description": "The deleted state is reached only through the delete route"}
        }
      },
      "AuthnAdminIdentifierWrite": {
        "type": "object",
        "required": ["kind", "value"],
        "properties": {
          "kind": {"type": "string", "enum": ["username", "email"], "description": "A phone number is added or changed only through an SMS code and is refused here"},
          "value": {"type": "string"},
          "verified_via": {"type": "string", "enum": ["", "admin"], "description": "How the administrator states the identifier came to be verified"}
        }
      },
      "AuthnAdminMFARequired": {
        "type": "object",
        "required": ["required"],
        "properties": {
          "required": {"type": "boolean"}
        }
      },
      "AuthnAdminPasswordReset": {
        "type": "object",
        "required": ["password"],
        "properties": {
          "password": {"type": "string", "description": "The temporary password, handed out once and never echoed, logged or audited"}
        }
      },
      "AuthnAdminSecretCreate": {
        "type": "object",
        "required": ["label"],
        "properties": {
          "label": {"type": "string"},
          "expires_at": {"type": "string", "format": "date-time", "description": "Absent mints a secret with no expiry"}
        }
      },
      "AuthnAdminMemberWrite": {
        "type": "object",
        "properties": {
          "active": {"type": "boolean"},
          "source": {"type": "string", "description": "Absent records the change as an administrator's"},
          "sso_exempt": {"type": "boolean"}
        }
      },
      "AuthnAdminMemberSSOExempt": {
        "type": "object",
        "required": ["sso_exempt"],
        "properties": {
          "sso_exempt": {"type": "boolean"}
        }
      },
      "AuthnAdminProviderWrite": {
        "type": "object",
        "required": ["protocol", "name", "provisioning"],
        "properties": {
          "tenant": {"type": "string", "description": "Absent on a create takes the path's tenant; a value that names another is refused"},
          "protocol": {"type": "string"},
          "name": {"type": "string"},
          "enabled": {"type": "boolean", "description": "Absent leaves the enabled flag as it is (false on a create)"},
          "provisioning": {"type": "string"},
          "trust_idp_mfa": {"type": "boolean", "description": "Absent leaves the flag as it is (false on a create)"},
          "allow_idp_initiated": {"type": "boolean", "description": "Absent leaves the flag as it is (false on a create)"},
          "allow_sha1": {"type": "boolean", "description": "Absent leaves the flag as it is (false on a create)"},
          "merge_existing": {"type": "boolean", "description": "Absent leaves the flag as it is (false on a create)"},
          "config": {"type": "object", "additionalProperties": true, "description": "The protocol's own configuration"},
          "client_secret": {"type": "string", "description": "Absent writes no client secret"}
        }
      },
      "AuthnAdminDomainClaim": {
        "type": "object",
        "required": ["domain"],
        "properties": {
          "domain": {"type": "string"}
        }
      }
    }
  }
}
