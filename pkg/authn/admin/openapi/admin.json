    "/auth/admin/accounts": {
      "get": {
        "operationId": "authn.admin.accounts.list",
        "summary": "List accounts, one page at a time",
        "parameters": [
          {"name": "status", "in": "query", "required": false, "schema": {"type": "string"}},
          {"name": "kind", "in": "query", "required": false, "schema": {"type": "string"}},
          {"name": "identifier_prefix", "in": "query", "required": false, "schema": {"type": "string"}},
          {"name": "identifier_kind", "in": "query", "required": false, "schema": {"type": "string"}},
          {"name": "display_name_prefix", "in": "query", "required": false, "schema": {"type": "string"}},
          {"name": "after", "in": "query", "required": false, "schema": {"type": "string"}},
          {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer"}}
        ],
        "responses": {
          "200": {
            "description": "The page of accounts and the next cursor",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AuthnAdminAccountList"}}}
          },
          "400": {"description": "The list's query could not be read"},
          "401": {"description": "No usable credential"},
          "403": {"description": "The caller is impersonating or may not read accounts"},
          "503": {"description": "A dependency could not answer"}
        }
      },
      "post": {
        "operationId": "authn.admin.accounts.create",
        "summary": "Create an account",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AuthnAdminAccountCreate"}}}},
        "responses": {
          "201": {
            "description": "The created account",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AuthnAdminAccountEnvelope"}}}
          },
          "400": {"description": "The body could not be read, or an argument is invalid"},
          "401": {"description": "No usable credential"},
          "403": {"description": "The caller is impersonating or may not create accounts"},
          "409": {"description": "An account with that identifier already exists"},
          "503": {"description": "A dependency could not answer"}
        }
      }
    },
    "/auth/admin/accounts/{id}": {
      "get": {
        "operationId": "authn.admin.accounts.get",
        "summary": "Read one account",
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {
            "description": "The account",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AuthnAdminAccountEnvelope"}}}
          },
          "401": {"description": "No usable credential"},
          "403": {"description": "The caller is impersonating or may not read the account"},
          "404": {"description": "No such account"},
          "503": {"description": "A dependency could not answer"}
        }
      },
      "patch": {
        "operationId": "authn.admin.accounts.patch",
        "summary": "Update an account",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AuthnAdminAccountPatch"}}}},
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {
            "description": "The updated account",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AuthnAdminAccountEnvelope"}}}
          },
          "400": {"description": "The body could not be read, or an argument is invalid"},
          "401": {"description": "No usable credential"},
          "403": {"description": "The caller is impersonating or may not update the account"},
          "404": {"description": "No such account"},
          "409": {"description": "A binding conflict, or the last login method"},
          "503": {"description": "A dependency could not answer"}
        }
      },
      "delete": {
        "operationId": "authn.admin.accounts.delete",
        "summary": "Delete an account",
        "parameters": [
          {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "204": {"description": "The account was deleted"},
          "401": {"description": "No usable credential"},
          "403": {"description": "The caller is impersonating or may not delete the account"},
          "404": {"description": "No such account"},
          "409": {"description": "The account is the last login method of something that needs it"},
          "503": {"description": "A dependency could not answer"}
        }
      }
    },
