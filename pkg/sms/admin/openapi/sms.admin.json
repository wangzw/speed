{
  "openapi": "3.1.0",
  "info": {"title": "sms.admin", "version": "1.0.0"},
  "paths": {
    "/api/v1/sms/admin/templates": {
      "get": {
        "operationId": "sms.admin.templates.list",
        "summary": "Page through the template set, configured templates included",
        "parameters": [
          {"name": "after", "in": "query", "required": false, "schema": {"type": "string"}, "description": "Continue after the template this name names"},
          {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 0}, "description": "The page's maximum size; the read surface caps it"}
        ],
        "responses": {
          "200": {
            "description": "One page of templates, ordered by name, and the cursor of the next, empty on the last page",
            "content": {"application/json": {"schema": {"type": "object", "required": ["templates", "next_cursor"], "properties": {"templates": {"type": "array", "items": {"$ref": "#/components/schemas/SmsAdminTemplate"}}, "next_cursor": {"type": "string"}}}}}
          },
          "400": {"description": "The limit is not a non-negative integer", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "401": {"description": "The request carries no identity", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "403": {"description": "The caller holds no sms.template.read in the platform domain", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "503": {"description": "A dependency could not answer", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}}
        }
      },
      "post": {
        "operationId": "sms.admin.templates.register",
        "summary": "Take up a template whose vendor code the operator already has",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SmsAdminRegister"}}}},
        "responses": {
          "201": {
            "description": "The registered template",
            "content": {"application/json": {"schema": {"type": "object", "required": ["template"], "properties": {"template": {"$ref": "#/components/schemas/SmsAdminTemplate"}}}}}
          },
          "400": {"description": "The name is empty, the body is not one object, or the template set is one the registry cannot run on", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "401": {"description": "The request carries no identity", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "403": {"description": "The caller holds no sms.template.manage in the platform domain", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "409": {"description": "The registry already holds the name", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "503": {"description": "A dependency could not answer", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}}
        }
      }
    },
    "/api/v1/sms/admin/templates/submissions": {
      "post": {
        "operationId": "sms.admin.templates.offer",
        "summary": "Hand a template to the vendor for review and take up the code it answers with",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SmsAdminSubmission"}}}},
        "responses": {
          "201": {
            "description": "The template the submission created",
            "content": {"application/json": {"schema": {"type": "object", "required": ["template"], "properties": {"template": {"$ref": "#/components/schemas/SmsAdminTemplate"}}}}}
          },
          "400": {"description": "The name is empty, the body is not one object, or the vendor or the registry refused the submission", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "401": {"description": "The request carries no identity", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "403": {"description": "The caller holds no sms.template.manage in the platform domain", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "409": {"description": "The registry already holds the name", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "503": {"description": "A dependency could not answer", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}}
        }
      }
    },
    "/api/v1/sms/admin/templates/{name}": {
      "delete": {
        "operationId": "sms.admin.templates.remove",
        "summary": "Drop a runtime template from this process, the vendor left alone",
        "parameters": [{"$ref": "#/components/parameters/SmsAdminName"}],
        "responses": {
          "204": {"description": "The template was removed"},
          "401": {"description": "The request carries no identity", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "403": {"description": "The caller holds no sms.template.manage in the platform domain", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "404": {"description": "The registry holds no template by the name", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "409": {"description": "The template came from the configuration and is immutable at runtime", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "503": {"description": "A dependency could not answer", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}}
        }
      }
    },
    "/api/v1/sms/admin/templates/{name}/enabled": {
      "post": {
        "operationId": "sms.admin.templates.setEnabled",
        "summary": "Turn a runtime template's ability to send on or off",
        "parameters": [{"$ref": "#/components/parameters/SmsAdminName"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}}}}}},
        "responses": {
          "204": {"description": "The state was changed"},
          "400": {"description": "The body names no state, or is not one object", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "401": {"description": "The request carries no identity", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "403": {"description": "The caller holds no sms.template.manage in the platform domain", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "404": {"description": "The registry holds no template by the name", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "409": {"description": "The template came from the configuration and is immutable at runtime", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "503": {"description": "A dependency could not answer", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}}
        }
      }
    }
  },
  "components": {
    "parameters": {
      "SmsAdminName": {"name": "name", "in": "path", "required": true, "schema": {"type": "string"}}
    },
    "schemas": {
      "SmsAdminTemplate": {
        "type": "object",
        "required": ["name", "source", "params", "locales", "approvals", "enabled", "version", "created_at", "updated_at"],
        "properties": {
          "name": {"type": "string"},
          "source": {"type": "string"},
          "params": {"type": "array", "items": {"type": "string"}},
          "locales": {"type": "array", "items": {"type": "string"}},
          "approvals": {"type": "object", "additionalProperties": {"$ref": "#/components/schemas/SmsAdminApproval"}},
          "enabled": {"type": "boolean"},
          "version": {"type": "integer", "format": "int64"},
          "created_at": {"type": "string", "format": "date-time"},
          "updated_at": {"type": "string", "format": "date-time"}
        }
      },
      "SmsAdminApproval": {
        "type": "object",
        "required": ["state"],
        "properties": {
          "state": {"type": "string"},
          "reason": {"type": "string"}
        }
      },
      "SmsAdminRegister": {
        "type": "object",
        "required": ["name", "params", "codes"],
        "properties": {
          "name": {"type": "string"},
          "params": {"type": "array", "items": {"type": "string"}},
          "codes": {"type": "object", "additionalProperties": {"type": "string"}}
        }
      },
      "SmsAdminSubmission": {
        "type": "object",
        "required": ["name", "content", "kind", "locale", "params", "remark"],
        "properties": {
          "name": {"type": "string"},
          "content": {"type": "string"},
          "kind": {"type": "string"},
          "locale": {"type": "string"},
          "params": {"type": "array", "items": {"type": "string"}},
          "remark": {"type": "string"}
        }
      },
      "Problem": {
        "type": "object",
        "required": ["type", "status"],
        "properties": {
          "type": {"type": "string"},
          "title": {"type": "string"},
          "status": {"type": "integer"},
          "detail": {"type": "string"},
          "instance": {"type": "string"}
        }
      }
    }
  }
}
