{
  "openapi": "3.1.0",
  "info": {"title": "tenant.admin", "version": "1.0.0"},
  "paths": {
    "/api/v1/tenant/admin/tenants": {
      "get": {
        "operationId": "tenant.admin.tenants.list",
        "summary": "List every tenant the roster holds",
        "responses": {
          "200": {
            "description": "Every tenant, in the roster's order by identifier",
            "content": {"application/json": {"schema": {"type": "object", "required": ["tenants"], "properties": {"tenants": {"type": "array", "items": {"$ref": "#/components/schemas/TenantAdminTenant"}}}}}}
          },
          "401": {"description": "The request carries no identity", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "403": {"description": "The caller holds no tenant.read in the platform domain", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "503": {"description": "A dependency could not answer", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}}
        }
      },
      "post": {
        "operationId": "tenant.admin.tenants.create",
        "summary": "Register an active tenant",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TenantAdminTenantRegistration"}}}},
        "responses": {
          "201": {
            "description": "The registered tenant",
            "content": {"application/json": {"schema": {"type": "object", "required": ["tenant"], "properties": {"tenant": {"$ref": "#/components/schemas/TenantAdminTenant"}}}}}
          },
          "400": {"description": "The identifier or the alias is outside the identifier domain", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "401": {"description": "The request carries no identity", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "403": {"description": "The caller holds no tenant.manage in the platform domain", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "409": {"description": "The identifier or the alias is already taken", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "503": {"description": "A dependency could not answer", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}}
        }
      }
    },
    "/api/v1/tenant/admin/tenants/{id}": {
      "get": {
        "operationId": "tenant.admin.tenants.get",
        "summary": "Read one tenant the roster holds",
        "parameters": [{"$ref": "#/components/parameters/TenantAdminTenantID"}],
        "responses": {
          "200": {
            "description": "The tenant",
            "content": {"application/json": {"schema": {"type": "object", "required": ["tenant"], "properties": {"tenant": {"$ref": "#/components/schemas/TenantAdminTenant"}}}}}
          },
          "401": {"description": "The request carries no identity", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "403": {"description": "The caller holds no tenant.read in the platform domain", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "404": {"description": "No tenant carries the identifier", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "503": {"description": "A dependency could not answer", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}}
        }
      },
      "patch": {
        "operationId": "tenant.admin.tenants.setAlias",
        "summary": "Change one tenant's alias",
        "parameters": [{"$ref": "#/components/parameters/TenantAdminTenantID"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["alias"], "properties": {"alias": {"type": "string"}}}}}},
        "responses": {
          "204": {"description": "The alias was changed"},
          "400": {"description": "The identifier or the alias is outside the identifier domain", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "401": {"description": "The request carries no identity", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "403": {"description": "The caller holds no tenant.manage in the platform domain", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "404": {"description": "No tenant carries the identifier", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "409": {"description": "The alias is already taken", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "503": {"description": "A dependency could not answer", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}}
        }
      }
    },
    "/api/v1/tenant/admin/tenants/{id}/status": {
      "post": {
        "operationId": "tenant.admin.tenants.setStatus",
        "summary": "Change one tenant's state",
        "parameters": [{"$ref": "#/components/parameters/TenantAdminTenantID"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["status"], "properties": {"status": {"type": "string", "enum": ["active", "disabled"]}}}}}},
        "responses": {
          "204": {"description": "The state was changed"},
          "400": {"description": "The identifier is outside the identifier domain or the status is outside the closed set active/disabled", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "401": {"description": "The request carries no identity", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "403": {"description": "The caller holds no tenant.manage in the platform domain", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "404": {"description": "No tenant carries the identifier", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "503": {"description": "A dependency could not answer", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}}
        }
      }
    }
  },
  "components": {
    "parameters": {
      "TenantAdminTenantID": {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}
    },
    "schemas": {
      "TenantAdminTenant": {
        "type": "object",
        "required": ["id", "alias", "status"],
        "properties": {
          "id": {"type": "string"},
          "alias": {"type": "string"},
          "status": {"type": "string", "enum": ["active", "disabled"]}
        }
      },
      "TenantAdminTenantRegistration": {
        "type": "object",
        "required": ["id", "alias"],
        "properties": {
          "id": {"type": "string"},
          "alias": {"type": "string"}
        }
      },
      "Problem": {
        "type": "object",
        "required": ["type", "status"],
        "properties": {
          "type": {"type": "string"},
          "title": {"type": "string"},
          "status": {"type": "integer"},
          "detail": {"type": "string"},
          "instance": {"type": "string"}
        }
      }
    }
  }
}
