{
  "openapi": "3.1.0",
  "info": {"title": "notification preferences", "version": "1.0.0"},
  "paths": {
    "/api/v1/notifications/types": {
      "get": {
        "operationId": "notification.preferences.listTypes",
        "summary": "The notification type taxonomy, one list every recipient shares",
        "responses": {
          "200": {
            "description": "The taxonomy",
            "content": {"application/json": {"schema": {"type": "object", "required": ["types"], "properties": {"types": {"type": "array", "items": {"$ref": "#/components/schemas/NotificationType"}}}}}}
          }
        }
      }
    },
    "/api/v1/notifications/preferences": {
      "get": {
        "operationId": "notification.preferences.listPreferences",
        "summary": "The caller's preference matrix, one row per type in the taxonomy",
        "responses": {
          "200": {
            "description": "The preference matrix; each row's channels are the effective set",
            "content": {"application/json": {"schema": {"type": "object", "required": ["preferences"], "properties": {"preferences": {"type": "array", "items": {"$ref": "#/components/schemas/NotificationPreference"}}}}}}
          },
          "503": {"description": "The preference matrix could not be read", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}}
        }
      }
    },
    "/api/v1/notifications/preferences/{typeKey}/{channel}": {
      "put": {
        "operationId": "notification.preferences.updatePreference",
        "summary": "Turn one channel on or off for one type and return that type's effective set",
        "parameters": [
          {"name": "typeKey", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "channel", "in": "path", "required": true, "schema": {"type": "string", "enum": ["in_app", "email", "sms"]}}
        ],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/NotificationSetPreferenceRequest"}}}},
        "responses": {
          "200": {
            "description": "The type's effective channel set after the update; a target equal to the current set answers without writing",
            "content": {"application/json": {"schema": {"type": "object", "required": ["type_key", "channels"], "properties": {"type_key": {"type": "string"}, "channels": {"type": "array", "items": {"type": "string"}}}}}}
          },
          "400": {"description": "The body is not readable, the channel is unknown, the type is not in the taxonomy, or no recipient is named", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "409": {"description": "The type cannot be unsubscribed", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
          "503": {"description": "The preference could not be read or written", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "NotificationType": {
        "type": "object",
        "required": ["key", "group", "default_channels", "unsubscribable", "recipient_visible_params"],
        "properties": {
          "key": {"type": "string"},
          "group": {"type": "string"},
          "default_channels": {"type": "array", "items": {"type": "string", "enum": ["in_app", "email", "sms"]}},
          "unsubscribable": {"type": "boolean"},
          "recipient_visible_params": {"type": "array", "items": {"type": "string"}}
        }
      },
      "NotificationPreference": {
        "type": "object",
        "required": ["type_key", "group", "channels", "explicit"],
        "properties": {
          "type_key": {"type": "string"},
          "group": {"type": "string"},
          "channels": {"type": "array", "items": {"type": "string", "enum": ["in_app", "email", "sms"]}},
          "explicit": {"type": "boolean", "description": "True when the channels came from a stored row, false when they are the type's default channels"}
        }
      },
      "NotificationSetPreferenceRequest": {
        "type": "object",
        "required": ["enabled"],
        "properties": {
          "enabled": {"type": "boolean", "description": "The target state of the channel; a body naming none is told apart from one naming false"}
        }
      },
      "Problem": {
        "type": "object",
        "required": ["type", "status"],
        "properties": {
          "type": {"type": "string"},
          "title": {"type": "string"},
          "status": {"type": "integer"},
          "detail": {"type": "string"},
          "instance": {"type": "string"}
        }
      }
    }
  }
}
