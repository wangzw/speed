{
  "extends": "../../tsconfig.base.json",
  "include": ["src", "test-utils"],
  "compilerOptions": {
    // tenancy-ui is a DOM-rendering package: JSX compiles through the
    // automatic runtime (react-jsx), same as ui-kit, layout-kit and
    // auth-ui.
    //
    // src/ renders MUI primitives (the tenant switcher) and reads
    // @speed/i18n translations; test-utils/ renders under the ui-kit theme
    // providers -- whose own sources import @speed/tokens and
    // @speed/i18n/mui-locale, which this program pulls into its graph, so
    // those two resolve to their sources as well -- and the tests compose
    // the host over @speed/auth-core's tenant context, whose sources
    // import @speed/api-client and @speed/api-sdk (@speed/api-sdk's
    // runtime subpath before its prefix), pulling those in too. The
    // siblings' published "types" point into their dist/,
    // which is never committed and not yet built in a fresh checkout, so
    // type resolution maps every workspace specifier straight onto the
    // sibling's source -- same pattern ui-kit, auth-core and auth-ui use.
    // Emitted dist/ keeps the bare specifiers, which consumers resolve
    // against the real published packages. Keep this in lockstep with what
    // src/ and test-utils/ import (the workspace alias suite pins this
    // section against the shared package map). List order matters:
    // "@speed/api-sdk/runtime" must be tried before its "@speed/api-sdk"
    // prefix, and "@speed/i18n/mui-locale" before "@speed/i18n" (first
    // match wins in paths).
    "jsx": "react-jsx",
    "paths": {
      "@speed/api-sdk/runtime": ["../api-sdk/src/runtime.ts"],
      "@speed/api-sdk": ["../api-sdk/src/index.ts"],
      "@speed/api-client": ["../api-client/src/index.ts"],
      "@speed/auth-core": ["../auth-core/src/index.ts"],
      "@speed/i18n/mui-locale": ["../i18n/src/mui-locale.ts"],
      "@speed/i18n": ["../i18n/src/index.ts"],
      "@speed/tokens": ["../tokens/src/index.ts"],
      "@speed/ui-kit": ["../ui-kit/src/index.ts"],
      "@speed/test-utils/axe": ["../../test-utils/src/axe.ts"],
      "@speed/test-utils/real-client": ["../../test-utils/src/real-client.ts"],
      "@speed/test-utils/render": ["../../test-utils/src/render.tsx"],
      "@speed/test-utils/session-harness": ["../../test-utils/src/session-harness.ts"],
      "@speed/test-utils/setup": ["../../test-utils/src/setup.ts"]
    }
  }
}
