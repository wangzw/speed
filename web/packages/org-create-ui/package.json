{
  "name": "@speed/org-create-ui",
  "version": "0.0.1",
  "description": "Speed organization-create UI: the shared creation form and validation, and the self-service creation page, over the org.create operation -- with every built-in string in the bilingual org-create-ui namespace",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md", "AGENTS.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "pnpm --filter @speed/i18n --filter @speed/ui-kit build && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@speed/i18n": "workspace:*",
    "@speed/ui-kit": "workspace:*"
  },
  "peerDependencies": {
    "@emotion/react": "^11.5.0",
    "@emotion/styled": "^11.3.0",
    "@mui/material": "^9.5.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "@speed/test-utils": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "axe-core": "^4.13.0",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
