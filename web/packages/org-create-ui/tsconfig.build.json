{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // ESM authoring rules: NodeNext emits relative imports verbatim, so
    // sources write explicit .js extensions. Siblings resolve through
    // their published exports maps to their emitted dist declarations.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "jsx": "react-jsx",
    "noEmit": false,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    // Incremental emit: the build info records what an earlier run emitted,
    // so a repeat build reads it and skips the unchanged files. The build
    // info sits in dist/ so a dist clean drops it with the output it
    // describes.
    "incremental": true,
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
