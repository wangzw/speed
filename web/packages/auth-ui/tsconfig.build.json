{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // ESM authoring rules: NodeNext mode makes tsc emit relative imports
    // verbatim, so sources must write explicit .js extensions (TS2835
    // otherwise) -- the emitted dist/ is then loadable by Node ESM and
    // typecheckable by NodeNext consumers as-is.
    //
    // Workspace siblings (@speed/i18n, @speed/auth-core) are resolved
    // here exactly like a consumer resolves them: through the package
    // exports map to the sibling's emitted dist/ declarations (no paths
    // mapping). tsconfig.json (the noEmit typecheck, tests included)
    // maps the workspace specifiers onto sibling sources instead; this
    // build type-checks against the siblings' emitted dist declarations.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "jsx": "react-jsx",
    "noEmit": false,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    // Incremental emit: the build info records what an earlier run emitted,
    // so a repeat build reads it and skips the unchanged files. The build
    // info sits in dist/ so a dist clean drops it with the output it
    // describes.
    "incremental": true,
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
