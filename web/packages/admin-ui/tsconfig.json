{
  "extends": "../../tsconfig.base.json",
  "include": ["src", "test-utils"],
  "compilerOptions": {
    // TypeScript 6 defaults `types` to [] (5.x included every visible
    // @types package), so the Node globals and `node:` built-ins the test
    // files use are named here.
    "types": ["node"],
    // admin-ui is a DOM-rendering package: JSX compiles through the
    // automatic runtime (react-jsx), same as ui-kit, auth-ui and
    // account-ui.
    //
    // The package renders the platform-staff console over the three
    // backend administration surfaces, reads @speed/i18n translations,
    // composes @speed/ui-kit components and builds its frame on
    // @speed/layout-kit's AppShell. src/ reaches those three through the
    // sibling-source paths below, and reaches the generated
    // surface of @speed/api-sdk (the shipped console operations bundle);
    // test-utils/ additionally binds a scripted request function into
    // api-sdk's runtime seam over @speed/api-client's RequestFn, and
    // renders under the ui-kit theme providers -- ui-kit's own sources
    // import @speed/tokens and @speed/i18n/mui-locale, which this
    // program pulls into its graph, so those two resolve to their
    // sources as well. The siblings' published "types" point into their
    // dist/, which is never committed and not yet built in a fresh
    // checkout, so type resolution maps every workspace specifier
    // straight onto the sibling's source -- same pattern ui-kit,
    // auth-core and account-ui use. Emitted dist/ keeps the bare
    // specifiers, which consumers resolve against the real published
    // packages. Keep this in lockstep with what src/ and test-utils/
    // import (the workspace alias map, web/scripts/speed-aliases.mjs).
    // List order matters: "@speed/i18n/mui-locale" must be tried before
    // its "@speed/i18n" prefix (first match wins in paths).
    "jsx": "react-jsx",
    "paths": {
      "@speed/api-sdk/runtime": ["../api-sdk/src/runtime.ts"],
      "@speed/api-sdk/features": ["../api-sdk/src/features.ts"],
      "@speed/api-sdk": ["../api-sdk/src/index.ts"],
      "@speed/api-client": ["../api-client/src/index.ts"],
      "@speed/auth-core/otpauth": ["../auth-core/src/otpauth.ts"],
      "@speed/auth-core/webauthn": ["../auth-core/src/webauthn.ts"],
      "@speed/auth-core": ["../auth-core/src/index.ts"],
      "@speed/i18n/mui-locale": ["../i18n/src/mui-locale.ts"],
      "@speed/i18n": ["../i18n/src/index.ts"],
      "@speed/theme-presets": ["../theme-presets/src/index.ts"],
      "@speed/tokens": ["../tokens/src/index.ts"],
      "@speed/layout-kit": ["../layout-kit/src/index.ts"],
      "@speed/org-create-ui": ["../org-create-ui/src/index.ts"],
      "@speed/ui-kit": ["../ui-kit/src/index.ts"],
      "@speed/test-utils/axe": ["../../test-utils/src/axe.ts"],
      "@speed/test-utils/emitted-css": ["../../test-utils/src/emitted-css.ts"],
      "@speed/test-utils/matchMedia": ["../../test-utils/src/matchMedia.ts"],
      "@speed/test-utils/render": ["../../test-utils/src/render.tsx"],
      "@speed/test-utils/timers": ["../../test-utils/src/timers.ts"],
      "@speed/test-utils/turnstile": ["../../test-utils/src/turnstile.ts"],
      "@speed/test-utils/wait": ["../../test-utils/src/wait.ts"],
      "@speed/test-utils/setup": ["../../test-utils/src/setup.ts"]
    }
  }
}
