{
  "name": "@speed/admin-ui",
  "version": "0.0.1",
  "description": "Speed console UI: the platform-staff console component family -- the second shell, with no tenant switcher, that renders the tenant roster, settings and audit administration surfaces as route declarations collected through the declaration seam",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "!dist/*.tsbuildinfo", "README.md", "AGENTS.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json",
    "test": "vitest run",
    "build": "pnpm --filter @speed/i18n --filter @speed/ui-kit --filter @speed/layout-kit --filter @speed/api-sdk --filter @speed/auth-core --filter @speed/org-create-ui --fail-if-no-match run build && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@speed/api-sdk": "workspace:*",
    "@speed/auth-core": "workspace:*",
    "@speed/i18n": "workspace:*",
    "@speed/layout-kit": "workspace:*",
    "@speed/org-create-ui": "workspace:*",
    "@speed/ui-kit": "workspace:*"
  },
  "peerDependencies": {
    "@emotion/react": "^11.5.0",
    "@emotion/styled": "^11.3.0",
    "@mui/material": "^9.5.0",
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-hook-form": "^7.0.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "@speed/api-client": "workspace:*",
    "@speed/test-utils": "workspace:*",
    "@speed/theme-presets": "workspace:*",
    "@tanstack/react-query": "^5.107.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "axe-core": "^4.13.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "7.92.0"
  }
}
