{
  "name": "@speed/tokens",
  "version": "0.0.1",
  "description": "Speed design tokens: pure-data color, typography, spacing, shape, breakpoints, z-index, surface and shadow defaults plus the deep-merge helper for project overrides",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "!dist/*.tsbuildinfo", "README.md", "AGENTS.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "pnpm --filter @speed/tokens... --fail-if-no-match --workspace-concurrency=1 run build:self",
    "build:self": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@mui/material": "^9.5.0"
  }
}
