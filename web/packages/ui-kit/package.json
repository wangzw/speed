{
  "name": "@speed/ui-kit",
  "version": "0.0.1",
  "description": "Speed UI kit: the MUI v9 theme factory (createAppTheme + AppThemeProvider), the controlled core components (PageHeader, EmptyState, ConfirmDialog, SidePanel, FormField, FormLayout, PhoneNumberField, DataTable, FileUploader), the refresh pair (RefreshButton + usePageRefresh), the clipboard and one-time-value pair (CopyButton + OneTimeValuePanel), the TOTP enrolment pair (TotpQrCode + TotpEnrollmentPanel) and the write-feedback scope (useWriteFeedback + WriteFeedbackRegion), bilingual out of the box through @speed/i18n",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md", "AGENTS.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json",
    "test": "vitest run",
    "build": "pnpm --filter @speed/tokens --filter @speed/theme-presets --filter @speed/i18n --fail-if-no-match run build && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@speed/i18n": "workspace:*",
    "@speed/theme-presets": "workspace:*",
    "@speed/tokens": "workspace:*",
    "libphonenumber-js": "^1.13.16",
    "qrcode-generator": "^2.0.4"
  },
  "peerDependencies": {
    "@emotion/react": "^11.5.0",
    "@emotion/styled": "^11.3.0",
    "@mui/material": "^9.5.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-hook-form": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "@speed/test-utils": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "axe-core": "^4.13.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "7.92.0",
    "typescript": "^5.9.3",
    "zod": "^4.0.0"
  }
}
