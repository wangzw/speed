{
  "extends": "../../tsconfig.base.json",
  "include": ["src", "test-utils"],
  "compilerOptions": {
    // TypeScript 6 defaults `types` to [] (5.x included every visible
    // @types package), so the Node globals and `node:` built-ins the test
    // files use are named here.
    "types": ["node"],
    // ui-kit is the first DOM-rendering package: JSX compiles through the
    // automatic runtime (react-jsx). The shared base stays JSX-free so the
    // data-only packages keep their plain setting.
    "jsx": "react-jsx",
    // ui-kit imports workspace siblings: @speed/tokens and @speed/i18n at
    // runtime, @speed/theme-presets as types only. The siblings' published
    // "types" point into their dist/, which is never committed and not yet
    // built in a fresh checkout (and building upstream to typecheck is a
    // footgun), so type resolution maps the workspace specifiers straight
    // onto the siblings' sources. Emitted dist/ keeps the bare specifier,
    // which consumers resolve against the real published packages. Keep the
    // two patterns in lockstep with what src/ imports (the workspace alias
    // suite pins this section against the shared package map). The
    // @speed/ui-kit entry is this package's own: the shared
    // @speed/test-utils/render primitive imports the display time-zone
    // provider by its published specifier, and this program compiles that
    // source through test-utils/, so the specifier resolves here exactly as
    // it does in every consumer's program.
    "paths": {
      "@speed/i18n/mui-locale": ["../i18n/src/mui-locale.ts"],
      "@speed/i18n": ["../i18n/src/index.ts"],
      "@speed/theme-presets": ["../theme-presets/src/index.ts"],
      "@speed/tokens": ["../tokens/src/index.ts"],
      "@speed/ui-kit": ["./src/index.ts"],
      "@speed/test-utils/axe": ["../../test-utils/src/axe.ts"],
      "@speed/test-utils/emitted-css": ["../../test-utils/src/emitted-css.ts"],
      "@speed/test-utils/render": ["../../test-utils/src/render.tsx"],
      "@speed/test-utils/turnstile": ["../../test-utils/src/turnstile.ts"],
      "@speed/test-utils/wait": ["../../test-utils/src/wait.ts"],
      "@speed/test-utils/setup": ["../../test-utils/src/setup.ts"]
    }
  }
}
