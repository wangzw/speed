{
  "name": "@speed/notification-ui",
  "version": "0.0.1",
  "description": "Speed notification UI: the notification-center component family (the header bell with its unread badge, the inbox surface with per-message and mark-all read, the per-type channel preference matrix, and the live server-sent-event subscription) over the generated notification operations, with every built-in string in the bilingual notification-ui namespace",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "!dist/*.tsbuildinfo", "README.md", "AGENTS.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json",
    "test": "vitest run",
    "build": "pnpm --filter @speed/api-client --filter @speed/api-sdk --filter @speed/auth-core --filter @speed/ui-kit --filter @speed/i18n --fail-if-no-match run build && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@speed/api-client": "workspace:*",
    "@speed/api-sdk": "workspace:*",
    "@speed/auth-core": "workspace:*",
    "@speed/i18n": "workspace:*",
    "@speed/ui-kit": "workspace:*"
  },
  "peerDependencies": {
    "@emotion/react": "^11.5.0",
    "@emotion/styled": "^11.3.0",
    "@mui/material": "^9.5.0",
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "@speed/test-utils": "workspace:*",
    "@tanstack/react-query": "^5.108.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "axe-core": "^4.14.1",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
