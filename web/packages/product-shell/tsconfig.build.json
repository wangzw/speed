{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // ESM authoring rules: NodeNext mode makes tsc emit relative imports
    // verbatim, so sources must write explicit .js extensions (TS2835
    // otherwise) -- the emitted dist/ is then loadable by Node ESM and
    // typecheckable by NodeNext consumers as-is.
    //
    // The workspace dependencies (@speed/auth-core, @speed/auth-ui,
    // @speed/i18n, @speed/layout-kit) are resolved here exactly like a
    // consumer resolves them: through each package's exports map to its
    // emitted dist/ declarations (no paths mapping). tsconfig.json (the
    // noEmit typecheck, tests included) maps the workspace specifiers
    // onto the siblings' source instead; this build type-checks against
    // the siblings' emitted dist declarations.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "jsx": "react-jsx",
    "noEmit": false,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    // Incremental emit: the build info records what an earlier run emitted,
    // so a repeat build reads it and skips the unchanged files. The build
    // info sits in dist/ so a dist clean drops it with the output it
    // describes.
    "incremental": true,
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
