{
  "name": "@speed/route-kit",
  "version": "0.0.1",
  "description": "Speed route kit: one declarative registration surface for a product's pages -- a RouteTable of path/view/label/permission declarations that RouteProvider installs over react-router-dom, with RouteView (match + fallback), useNavItems (label-derived navigation with selected state), RouteLink and useNavigate; independent of the shell and of every sibling package",
  "type": "module",
  "private": false,
  "sideEffects": false,
  "files": ["dist", "!dist/*.tsbuildinfo", "README.md", "AGENTS.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json",
    "test": "vitest run",
    "build": "pnpm --filter @speed/route-kit... --fail-if-no-match --workspace-concurrency=1 run build:self",
    "build:self": "tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@speed/test-utils": "workspace:*",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  }
}
