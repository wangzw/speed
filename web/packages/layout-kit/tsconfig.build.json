{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // ESM authoring rules: NodeNext mode makes tsc emit relative imports
    // verbatim, so sources must write explicit .js extensions (TS2835
    // otherwise) -- the emitted dist/ is then loadable by Node ESM and
    // typecheckable by NodeNext consumers as-is.
    //
    // The workspace sibling (@speed/i18n) is resolved here exactly like a
    // consumer resolves it: through the package exports map to the
    // sibling's emitted dist/ declarations (no paths mapping). tsconfig.json
    // (the noEmit typecheck, tests included) maps the workspace specifier
    // onto the sibling's source instead; this build type-checks against
    // the sibling's emitted dist declarations.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "jsx": "react-jsx",
    "noEmit": false,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    // Incremental emit: the build info records what an earlier run emitted,
    // so a repeat build reads it and skips the unchanged files. The build
    // info sits in dist/ so a dist clean drops it with the output it
    // describes.
    "incremental": true,
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
