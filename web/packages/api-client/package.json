{
  "name": "@speed/api-client",
  "version": "0.0.1",
  "description": "Speed hand-written API runtime: injectable fetch, memory-only bearer-token attachment, silent single-flight 401 refresh, ApiError envelope normalization and idempotent-only retry -- the HTTP layer the generated @speed/api-sdk surface calls",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "README.md",
    "AGENTS.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "pnpm --filter @speed/api-client... --fail-if-no-match --workspace-concurrency=1 run build:self",
    "build:self": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@speed/test-utils": "workspace:*",
    "@types/node": "^26.6.6"
  }
}
