{
  "name": "@speed/theme-presets",
  "version": "0.0.1",
  "description": "Speed theme presets: named, ready-made token overrides (default, classic, modern, compact, glass, ascii) as pure data above @speed/tokens, with no React, MUI or i18n dependency",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "!dist/*.tsbuildinfo", "README.md", "AGENTS.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "pnpm --filter @speed/theme-presets... --fail-if-no-match --workspace-concurrency=1 run build:self",
    "build:self": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@speed/tokens": "workspace:*"
  }
}
