# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
*.local

# Go
*.test
*.out
# Workspace-mode dependency checksums; go.work lists only in-repo modules.
go.work*.sum

# Python (the checkers under tools/ and the skills' own scripts)
__pycache__/
*.pyc

# Node
node_modules/
dist/
# Vitest's coverage output, written beside each package's config by a run
# that asks for it (`pnpm -C web -r test --coverage`).
coverage/
# The browser tier's failure artifacts: Vitest writes screenshots beside
# the failing case and attachments under the workspace root.
**/__screenshots__/
.vitest-attachments/
.turbo/
*.tsbuildinfo

# Playwright (the e2e tier): its config writes the run's artifacts and HTML
# report under /tmp, but a run that overrides those locations -- or a future
# config that forgets to -- leaves them beside the config. They are outputs,
# never committed. tools/check_e2e_honesty.py keeps the configured outputDir
# under /tmp; these patterns are the backstop for a run that bypasses it.
**/test-results/
**/playwright-report/
**/blob-report/
**/playwright/.cache/

/tmp/

# Local data (standalone deployment mode)
*.db
*.db-journal
*.sqlite

# Runtime state a deployment writes beside the program it runs from: the token
# signing key generated on the first run, the local object-store root. It
# belongs to a deployment, not to the source tree. A program started from the
# repository root lands it here (the demo's own copy is under server/).
/var/

# Hugo build output for docs/site/ (docs/site/README.md) -- generated
# by `hugo --minify`,
# never committed. Hugo's default resource cache directory and its build
# lock file, also never committed.
/docs/site/public/
/docs/site/resources/
/docs/site/.hugo_build.lock

.claude/dashboard/
