
authn:

  gate:
    mount:
      public-url: "http://localhost:8080"
  mfa:
    webauthn:
      origins: ["http://localhost:8080"]

  humanverify:
    mode: off
    phone-mode: off

  invitemail:
    accept-base-url: "http://localhost:8080"

mail:
  carrier: log

sms:
  carrier: log
  registry:
    templates:
      authn.code.login:
        kind: verification
        params: ["code", "ttl_minutes"]
        codes:
          en-US: "demo-login"
          zh-CN: "demo-login-zh"
      authn.code.mfa:
        kind: verification
        params: ["code", "ttl_minutes"]
        codes:
          en-US: "demo-mfa"
          zh-CN: "demo-mfa-zh"
      authn.code.enroll:
        kind: verification
        params: ["code", "ttl_minutes"]
        codes:
          en-US: "demo-enroll"
          zh-CN: "demo-enroll-zh"
      authn.code.reset:
        kind: verification
        params: ["code", "ttl_minutes"]
        codes:
          en-US: "demo-reset"
          zh-CN: "demo-reset-zh"

seed:
  settings:
    - key: "authn.mfa.sensitive-min-age"
      value: "1h"
    - key: "authn.sms.allowed-prefixes"
      value: '["+1","+86"]'
    - key: "authn.account.signup"
      value: "open"
