{
  "name": "demo-web",
  "version": "0.0.0",
  "private": true,
  "description": "The demo starter's web host: the browser application of the copyable product skeleton, built into server/dist and embedded into the Go binary by the demo program",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "api:gen": "go -C ../server run . --config file:testdata/sqlite-memory.yaml sqlite-memory gen --title speed -o ../../../contracts/api.json && pnpm dlx orval@8.17.0 --config orval.config.ts && node ../../../web/scripts/orval-nodenext-fixup.mjs src/app-api/index.ts src/app-api/runtime.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.4.0",
    "@speed/auth-ui": "^0.0.1",
    "@speed/console-ui": "^0.0.1",
    "@speed/i18n": "^0.0.1",
    "@speed/layout-kit": "^0.0.1",
    "@speed/product-shell": "^0.0.1",
    "@speed/route-kit": "^0.0.1",
    "@speed/ui-kit": "^0.0.1",
    "@tanstack/react-query": "^5.62.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.0.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@speed/api-client": "^0.0.1",
    "@speed/auth-core": "^0.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
