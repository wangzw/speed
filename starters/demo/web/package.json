{
  "name": "demo-web",
  "version": "0.0.0",
  "private": true,
  "description": "The demo starter's web host: the browser application of the copyable product skeleton, built into server/dist and embedded into the Go binary by the demo program",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "api:gen": "go -C ../server run . --config file:testdata/sqlite-memory.yaml sqlite-memory gen --title speed -o ../../../contracts/api.json --features ../../../contracts/features.json && node scripts/feature-names.mjs ../../../contracts/features.json src/app-api/features.ts && pnpm dlx orval@8.17.0 --config orval.config.ts && node scripts/orval-nodenext-fixup.mjs src/app-api/index.ts src/app-api/runtime.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:a11y": "vitest run --config vitest.a11y.config.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "@speed/account-ui": "^0.0.1",
    "@speed/api-client": "^0.0.1",
    "@speed/api-sdk": "^0.0.1",
    "@speed/auth-core": "^0.0.1",
    "@speed/auth-ui": "^0.0.1",
    "@speed/admin-ui": "^0.0.1",
    "@speed/org-create-ui": "^0.0.1",
    "@speed/i18n": "^0.0.1",
    "@speed/layout-kit": "^0.0.1",
    "@speed/notification-ui": "^0.0.1",
    "@speed/product-shell": "^0.0.1",
    "@speed/route-kit": "^0.0.1",
    "@speed/tenancy-ui": "^0.0.1",
    "@speed/theme-presets": "^0.0.1",
    "@speed/ui-kit": "^0.0.1",
    "@tanstack/react-query": "^5.107.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "axe-core": "^4.13.0",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
