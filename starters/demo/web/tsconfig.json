{
  "extends": "../../../web/tsconfig.base.json",
  "include": ["src"],
  "compilerOptions": {
    // The demo host is a DOM-rendering browser application: JSX compiles
    // through the automatic runtime, the same setting every DOM package in
    // web/ uses and the one vite's esbuild transform reads, so no separate
    // React plugin is needed.
    "jsx": "react-jsx",
    // The app lives outside web/ (starters/demo/web, a workspace member
    // through web/pnpm-workspace.yaml), and it composes the @speed packages
    // as a delivered consumer project does. In the repository the packages
    // are consumed as the workspace siblings' live src through the
    // workspace's single package map (web/scripts/speed-aliases.mjs), which
    // the vite and vitest configs import directly and this section mirrors:
    // tsconfig cannot import, so src/alias-manifest.test.ts pins these
    // entries against speedTsconfigPaths() for this directory's depth. A
    // published sibling's dist/ is never committed and may not exist when
    // this app typechecks, so resolution maps every workspace specifier onto
    // its source. List order matters -- a subpath entry must be tried before
    // the entry that is its prefix (first match wins in paths).
    "paths": {
      "@speed/api-sdk/runtime": ["../../../web/packages/api-sdk/src/runtime.ts"],
      "@speed/api-sdk": ["../../../web/packages/api-sdk/src/index.ts"],
      "@speed/api-client/react": ["../../../web/packages/api-client/src/react.ts"],
      "@speed/api-client": ["../../../web/packages/api-client/src/index.ts"],
      "@speed/auth-core": ["../../../web/packages/auth-core/src/index.ts"],
      "@speed/auth-ui": ["../../../web/packages/auth-ui/src/index.ts"],
      "@speed/tenancy-ui": ["../../../web/packages/tenancy-ui/src/index.ts"],
      "@speed/account-ui": ["../../../web/packages/account-ui/src/index.ts"],
      "@speed/console-ui": ["../../../web/packages/console-ui/src/index.ts"],
      "@speed/objectstore-ui": ["../../../web/packages/objectstore-ui/src/index.ts"],
      "@speed/product-shell/bootstrap": ["../../../web/packages/product-shell/src/bootstrap.tsx"],
      "@speed/product-shell": ["../../../web/packages/product-shell/src/index.ts"],
      "@speed/layout-kit": ["../../../web/packages/layout-kit/src/index.ts"],
      "@speed/route-kit": ["../../../web/packages/route-kit/src/index.ts"],
      "@speed/i18n/mui-locale": ["../../../web/packages/i18n/src/mui-locale.ts"],
      "@speed/i18n/platform-errors": ["../../../web/packages/i18n/src/platform-errors.ts"],
      "@speed/i18n": ["../../../web/packages/i18n/src/index.ts"],
      "@speed/tokens": ["../../../web/packages/tokens/src/index.ts"],
      "@speed/ui-kit": ["../../../web/packages/ui-kit/src/index.ts"],
      "@speed/test-utils/axe": ["../../../web/test-utils/src/axe.ts"],
      "@speed/test-utils/emitted-css": ["../../../web/test-utils/src/emitted-css.ts"],
      "@speed/test-utils/matchMedia": ["../../../web/test-utils/src/matchMedia.ts"],
      "@speed/test-utils/real-client": ["../../../web/test-utils/src/real-client.ts"],
      "@speed/test-utils/render": ["../../../web/test-utils/src/render.tsx"],
      "@speed/test-utils/session-harness": ["../../../web/test-utils/src/session-harness.ts"],
      "@speed/test-utils/setup": ["../../../web/test-utils/src/setup.ts"]
    }
  }
}
