# The configuration the Fly.io deployment runs on: an override document over
# the platform defaults compiled into the binary (server/defaults.yaml).
#
# The entrypoint (entrypoint.sh beside this file) renders the placeholders
# below at container start and writes the result to /data/config.yaml. Every
# placeholder is either derived from the Machine's own environment or read from
# a Fly secret, so no credential lives in this file or in the image. The
# deployment's stack is the sqlite one: the database, the key-value store and
# the event bus are the process's own, and the volume mounted at /data is what
# keeps the database, the token signing key and the object store across
# deploys.
#
# The values with no placeholder are this deployment's choices, not
# credentials: the listeners bind every address because Fly's proxy and health
# checker connect over the Machine's private network, and the working directory
# is /data so the relative paths below all land on the volume.
#
# The mounting table — which endpoint each capability sits on, and the
# endpoints the guards cover — is carried in full by the compiled-in document,
# required items included, so this file states none of it. What remains below
# is what differs between deployments: the topology this one reaches the
# world at, the paths on its volume, and its credentials.

http:
  listeners:
    backend:
      address: "0.0.0.0:8080"
    ops:
      address: "0.0.0.0:8083"
  # Fly's proxy is the only peer whose forwarded headers are believed. Fly
  # appends the app's own Anycast address as the rightmost X-Forwarded-For
  # entry, so the client address is read from Fly-Client-IP instead. The
  # trusted network is the proxy's hop into the Machine, not 6PN (fdaa::/16):
  # a peer arriving over 6PN is another Machine, not the proxy.
  trusted-proxies: ["172.16.0.0/16"]
  remote-ip-headers: ["Fly-Client-IP"]
  # The api endpoint's CORS policy. The frontend and the API share one origin
  # here, so no cross-origin request is expected; the public origin is named
  # as the starting point for a deployment that splits the two.
  cors:
    endpoints:
      api:
        allow-origins:
          - "__PUBLIC_ORIGIN__"

ops:
  title: demo
  version: 0.1.0
  description: "The demo assembly's API: every operation the modules named in this stack declare, merged from their OpenAPI fragments."
  servers: ["__PUBLIC_ORIGIN__"]

observability:
  otel:
    service-name: demo

authn:
  gate:
    mount:
      # The origin the deployment is reached at from outside. It is the origin
      # a browser signs in from and the origin the WebAuthn relying party is
      # bound to; the entrypoint derives it from the Machine's app name, or
      # takes it from the DEMO_PUBLIC_URL secret for a custom domain.
      public-url: "__PUBLIC_ORIGIN__"
  # The two social login methods the image assembles. Each section is an OAuth
  # application registered with the provider; the entrypoint renders both from
  # Fly secrets. The redirect URI registered with the provider is the public
  # origin, the capability's base path and the method's own callback path:
  # __PUBLIC_ORIGIN__/api/v1/auth/callback/google and .../github.
  login:
    google:
      client-id: "__GOOGLE_CLIENT_ID__"
      client-secret: "__GOOGLE_CLIENT_SECRET__"
    github:
      client-id: "__GITHUB_CLIENT_ID__"
      client-secret: "__GITHUB_CLIENT_SECRET__"
  # The token signing key. The program generates one at this path on its first
  # run and keeps it afterwards; the path is relative to the working directory
  # (/data), so the key survives a redeploy with the volume.
  token:
    signing-key-file: var/token-signing-key.pem
  mfa:
    totp:
      issuer: demo
    webauthn:
      # The relying party id is a domain and carries no scheme or port.
      rp-id: "__PUBLIC_DOMAIN__"
      rp-name: demo
      origins:
        - "__PUBLIC_ORIGIN__"
  # The human-verification gate. It runs off unless the deployment names a
  # mode. The self-hosted proof-of-work mode needs nothing rendered here; the
  # turnstile mode needs the widget's public site key and the secret that
  # authenticates siteverify, which the entrypoint requires only when that mode
  # is chosen. The hostname the widget must have run on is this deployment's own
  # public domain, so it takes the same placeholder the WebAuthn relying party
  # does.
  humanverify:
    mode: "__HUMANVERIFY_MODE__"
    site-key: "__TURNSTILE_SITE_KEY__"
    secret-key: "__TURNSTILE_SECRET_KEY__"
    hostname: "__PUBLIC_DOMAIN__"

# The mail carrier the registration flow sends verification codes through.
# The image is built with the deploy tag, which adds mail.smtp and
# authn.emailcode to the baseline. Every value is a Fly secret rendered by the
# entrypoint; the carrier is real, so a registration sends a real message.
mail:
  smtp:
    host: "__SMTP_HOST__"
    port: __SMTP_PORT__
    tls: "__SMTP_TLS__"
    username: "__SMTP_USERNAME__"
    password: "__SMTP_PASSWORD__"
    from: "__SMTP_FROM__"

# The host's own personal-tenant policy. On for this deployment: self-service
# registration is open, so an account that proves its email address gets a
# personal tenant instead of landing in an area it cannot enter. The seeded
# operator keeps the tenant the seed names.
workspace:
  personal:
    enabled: true

# The object store's bytes, under the volume.
objectstore:
  fs:
    root: "./objects"

# The deployment's first account and the tenant it administers. The seed
# command is idempotent: a second run leaves an existing account, tenant, role,
# grant or binding as it stands, so the entrypoint can run it on every start.
seed:
  accounts:
    - identifier: "__OPERATOR_EMAIL__"
      password: "__OPERATOR_PASSWORD__"
      display-name: Demo Operator
      platform-admin: true
  tenants:
    - acme
  settings:
    # The anonymous username-and-password registration is open; the account
    # is usable immediately and proves its email address afterwards.
    - key: "authn.account.password-signup"
      value: "open"
    # A first social login opens an account too. The provider has proved the
    # identity, and an address it reports as verified is written as an email
    # identifier; with this switch closed, only an account that already holds
    # the binding could sign in with Google or GitHub.
    - key: "authn.account.signup"
      value: "open"

# The engine. The database file is on the volume; the encryption key seals the
# columns a module encrypts at rest. The key is a secret and must stay the same
# for the life of the volume: rotating it makes the sealed columns unreadable,
# and the module's own retirement list is the way to change it.
db:
  sqlite:
    dsn: "./demo.db"
    encryption-key: "__ENCRYPTION_KEY__"
