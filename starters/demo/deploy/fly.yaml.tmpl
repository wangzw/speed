
http:
  listeners:
    backend:
      address: "0.0.0.0:8080"
    ops:
      address: "0.0.0.0:8083"
  endpoints:
    api:
      listener: backend
      prefixes: ["/api"]
    account:
      listener: backend
      prefixes: ["/api/v1/auth", "/api/v1/features", "/api/v1/orgs"]
    admin:
      listener: backend
      prefixes: ["/api/v1/system/audit", "/api/v1/system/auth", "/api/v1/system/permissions", "/api/v1/system/settings", "/api/v1/system/sms", "/api/v1/system/tenants"]
    content:
      listener: backend
      prefixes: ["/content"]
      max-body-bytes: 0
    ops:
      listener: ops
    web:
      listener: backend
      prefixes: ["/"]
  trusted-proxies: ["172.16.0.0/16"]
  remote-ip-headers: ["Fly-Client-IP"]
  cors:
    endpoints:
      api:
        allow-origins:
          - "__PUBLIC_ORIGIN__"

ops:
  title: demo
  version: 0.1.0
  description: "The demo assembly's API: every operation the modules named in this stack declare, merged from their OpenAPI fragments."
  servers: ["__PUBLIC_ORIGIN__"]

observability:
  otel:
    service-name: demo

authn:
  gate:
    mount:
      public-url: "__PUBLIC_ORIGIN__"
  login:
    google:
      client-id: "__GOOGLE_CLIENT_ID__"
      client-secret: "__GOOGLE_CLIENT_SECRET__"
    github:
      client-id: "__GITHUB_CLIENT_ID__"
      client-secret: "__GITHUB_CLIENT_SECRET__"
  token:
    signing-key-file: var/token-signing-key.pem
  mfa:
    totp:
      issuer: Speed Demo
    webauthn:
      rp-id: "__PUBLIC_DOMAIN__"
      rp-name: Speed Demo
      origins:
        - "__PUBLIC_ORIGIN__"
  humanverify:
    mode: "__HUMANVERIFY_MODE__"
    phone-mode: "__HUMANVERIFY_PHONE_MODE__"
    site-key: "__TURNSTILE_SITE_KEY__"
    secret-key: "__TURNSTILE_SECRET_KEY__"
    hostname: "__PUBLIC_DOMAIN__"
    action: "__TURNSTILE_ACTION__"

mail:
  smtp:
    host: "__SMTP_HOST__"
    port: __SMTP_PORT__
    tls: "__SMTP_TLS__"
    username: "__SMTP_USERNAME__"
    password: "__SMTP_PASSWORD__"
    from: "__SMTP_FROM__"

sms:
  carrier: log
  registry:
    templates:
      authn.code.login:
        kind: verification
        params: ["code", "ttl_minutes"]
        codes:
          en-US: "demo-login"
          zh-CN: "demo-login-zh"
      authn.code.mfa:
        kind: verification
        params: ["code", "ttl_minutes"]
        codes:
          en-US: "demo-mfa"
          zh-CN: "demo-mfa-zh"
      authn.code.enroll:
        kind: verification
        params: ["code", "ttl_minutes"]
        codes:
          en-US: "demo-enroll"
          zh-CN: "demo-enroll-zh"
      authn.code.reset:
        kind: verification
        params: ["code", "ttl_minutes"]
        codes:
          en-US: "demo-reset"
          zh-CN: "demo-reset-zh"

objectstore:
  fs:
    root: "./objects"

seed:
  tenants: []
  accounts:
    - identifier: "__OPERATOR_EMAIL__"
      username: "__OPERATOR_USERNAME__"
      password: "__OPERATOR_PASSWORD__"
      display-name: Demo Operator
      platform-admin: true
  settings:
    - key: "authn.account.password-signup"
      value: "open"
    - key: "authn.account.signup"
      value: "open"
    - key: "authn.sms.allowed-prefixes"
      value: '["+1","+86"]'
    - key: "authn.login.password-reset"
      value: "open"

db:
  sqlite:
    dsn: "./demo.db"
    encryption-key: "__ENCRYPTION_KEY__"
