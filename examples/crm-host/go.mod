module github.com/vislake/speed/examples/crm-host

go 1.26.0

// The pkg module has no released version yet, so this host resolves it from the
// sibling checkout. A consumer of a published example would drop the replace
// directive and depend on the released version.
replace github.com/vislake/speed/pkg => ../../pkg

