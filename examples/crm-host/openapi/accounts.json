{
  "openapi": "3.1.0",
  "info": {"title": "crm-host accounts", "version": "0.1.0"},
  "paths": {
    "/accounts": {
      "get": {
        "summary": "List one page of the tenant's accounts, by name and then identifier; the page size is the accounts.page-size setting",
        "parameters": [
          {"$ref": "#/components/parameters/Tenant"},
          {"name": "page", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1}, "description": "The page, from 1"},
          {"name": "q", "in": "query", "required": false, "schema": {"type": "string"}, "description": "Only the names containing this text, compared without regard to case"}
        ],
        "responses": {
          "200": {"description": "The page and the total", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AccountPage"}}}},
          "422": {"description": "The page is not a whole number in range", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      },
      "post": {
        "summary": "Create an account in the tenant; a rep or above. The owner is the caller unless the body names another member",
        "parameters": [{"$ref": "#/components/parameters/Tenant"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AccountCreate"}}}},
        "responses": {
          "201": {"description": "The account", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Account"}}}},
          "400": {"description": "The body is not JSON of this shape: empty, not valid JSON, or a member of another type than the one it takes", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "403": {"description": "The caller's role is below rep", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "409": {"description": "The tenant already holds an account under this identifier", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "422": {"description": "The name is empty, the identifier is malformed, or the owner is not a member", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/accounts/{id}": {
      "get": {
        "summary": "Read one account with its contacts",
        "parameters": [{"$ref": "#/components/parameters/Tenant"}, {"$ref": "#/components/parameters/AccountID"}],
        "responses": {
          "200": {"description": "The account", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AccountDetail"}}}},
          "404": {"description": "The tenant holds no such account", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      },
      "patch": {
        "summary": "Change the named fields of an account; a rep or above",
        "parameters": [{"$ref": "#/components/parameters/Tenant"}, {"$ref": "#/components/parameters/AccountID"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AccountPatch"}}}},
        "responses": {
          "200": {"description": "The account as it now stands", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Account"}}}},
          "400": {"description": "The body is not JSON of this shape: empty, not valid JSON, or a member of another type than the one it takes", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "403": {"description": "The caller's role is below rep", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "404": {"description": "The tenant holds no such account", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "422": {"description": "The change names nothing or empties the name", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      },
      "delete": {
        "summary": "Soft-delete an account and its contacts; an admin or above",
        "parameters": [{"$ref": "#/components/parameters/Tenant"}, {"$ref": "#/components/parameters/AccountID"}],
        "responses": {
          "204": {"description": "Deleted"},
          "403": {"description": "The caller's role is below admin", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "404": {"description": "The tenant holds no such account", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/accounts/{id}/owner": {
      "post": {
        "summary": "Hand an account to another member of the tenant; a rep or above",
        "parameters": [{"$ref": "#/components/parameters/Tenant"}, {"$ref": "#/components/parameters/AccountID"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AccountOwner"}}}},
        "responses": {
          "200": {"description": "The account as it now stands", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Account"}}}},
          "400": {"description": "The body is not JSON of this shape: empty, not valid JSON, or a member of another type than the one it takes", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "403": {"description": "The caller's role is below rep", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "404": {"description": "The tenant holds no such account", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "422": {"description": "The owner is empty or not a member of the tenant", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/accounts/{id}/purge": {
      "post": {
        "summary": "Remove an account and its contacts from their tables, deleted or not; an owner only",
        "parameters": [{"$ref": "#/components/parameters/Tenant"}, {"$ref": "#/components/parameters/AccountID"}],
        "responses": {
          "204": {"description": "Purged"},
          "403": {"description": "The caller is not an owner", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "404": {"description": "The tenant holds no such account", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "409": {"description": "A deal names the account, deleted or not, or names one of its contacts as a stakeholder", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Tenant": {"name": "X-Tenant", "in": "header", "required": true, "schema": {"type": "string"}, "description": "The alias of the tenant the request is scoped to"},
      "AccountID": {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}, "description": "The account's identifier within the tenant"}
    },
    "schemas": {
      "Account": {
        "type": "object",
        "properties": {
          "tenant_id": {"type": "string"},
          "id": {"type": "string"},
          "name": {"type": "string"},
          "domain": {"type": "string"},
          "industry": {"type": "string"},
          "owner": {"type": "string", "description": "The owning member's account identifier"},
          "created_at": {"type": "string", "format": "date-time"},
          "updated_at": {"type": "string", "format": "date-time"}
        },
        "required": ["tenant_id", "id", "name", "domain", "industry", "owner", "created_at", "updated_at"]
      },
      "AccountDetail": {
        "allOf": [
          {"$ref": "#/components/schemas/Account"},
          {"type": "object", "properties": {"contacts": {"type": "array", "items": {"$ref": "#/components/schemas/Contact"}}}, "required": ["contacts"]}
        ]
      },
      "AccountPage": {
        "type": "object",
        "properties": {
          "accounts": {"type": "array", "items": {"$ref": "#/components/schemas/Account"}},
          "page": {"type": "integer"},
          "page_size": {"type": "integer"},
          "total": {"type": "integer"}
        },
        "required": ["accounts", "page", "page_size", "total"]
      },
      "AccountCreate": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "description": "1 to 64 letters, digits, '-' or '_'; drawn when absent"},
          "name": {"type": "string"},
          "domain": {"type": "string"},
          "industry": {"type": "string"},
          "owner": {"type": "string", "description": "A member's account identifier; the caller when absent"}
        },
        "required": ["name"]
      },
      "AccountPatch": {
        "type": "object",
        "properties": {"name": {"type": "string"}, "domain": {"type": "string"}, "industry": {"type": "string"}}
      },
      "AccountOwner": {
        "type": "object",
        "properties": {"owner": {"type": "string"}},
        "required": ["owner"]
      },
      "Contact": {
        "type": "object",
        "properties": {
          "tenant_id": {"type": "string"},
          "id": {"type": "string"},
          "account_id": {"type": "string"},
          "name": {"type": "string"},
          "email": {"type": "string"},
          "phone": {"type": ["string", "null"]},
          "title": {"type": "string"},
          "created_at": {"type": "string", "format": "date-time"}
        },
        "required": ["tenant_id", "id", "account_id", "name", "email", "phone", "title", "created_at"]
      },
      "Error": {
        "type": "object",
        "properties": {"error": {"type": "string"}},
        "required": ["error"]
      }
    }
  }
}
