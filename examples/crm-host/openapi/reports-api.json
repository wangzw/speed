{
  "openapi": "3.1.0",
  "info": {"title": "crm-host reports", "version": "0.1.0"},
  "paths": {
    "/reports/pipeline": {
      "get": {
        "summary": "The tenant's deals summed by stage and currency, in the order of the tenant's stages, served from the cache for the tenant's reports.cache-ttl until a deal event invalidates it",
        "parameters": [{"$ref": "#/components/parameters/Tenant"}],
        "responses": {
          "200": {"description": "The report", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PipelineReport"}}}},
          "503": {"description": "The deals or the cache cannot be read", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/reports/leaderboard": {
      "get": {
        "summary": "The tenant's deals in a won stage in one currency, summed by owner",
        "description": "Read from the deals as they now are: a deal counts once, at its current amount, while it is in a stage of kind won and not deleted. The won revenue at /revenue is the running total of the deal.won events instead.",
        "parameters": [{"$ref": "#/components/parameters/Tenant"}, {"$ref": "#/components/parameters/Currency"}],
        "responses": {
          "200": {"description": "The leaderboard", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Leaderboard"}}}},
          "400": {"description": "The currency is not a three-letter code", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/revenue": {
      "get": {
        "summary": "The tenant's won deals and their amounts added up, per currency, as the revenue projection counted them from deal.won",
        "description": "A running total of the tenant's deal.won events: each is counted once, with the amount the deal had when it was won, and nothing else moves it. A deal won again after it left the won stage is counted again, and a change of a won deal's amount or its deletion leaves the line as it was. The leaderboard and the pipeline report's won rows answer from the deals as they now are.",
        "parameters": [{"$ref": "#/components/parameters/Tenant"}],
        "responses": {
          "200": {"description": "One line per currency the tenant has won a deal in", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RevenueList"}}}},
          "403": {"description": "The caller is not a member of the tenant", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/reports/webhook-deliveries": {
      "get": {
        "summary": "The tenant's most recent webhook deliveries",
        "parameters": [{"$ref": "#/components/parameters/Tenant"}],
        "responses": {
          "200": {"description": "The deliveries", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/WebhookDeliveries"}}}}
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Tenant": {"name": "X-Tenant", "in": "header", "required": true, "schema": {"type": "string"}, "description": "The alias of the tenant the request is scoped to"},
      "Currency": {"name": "currency", "in": "query", "required": true, "schema": {"type": "string", "pattern": "^[A-Z]{3}$"}}
    },
    "schemas": {
      "PipelineReport": {
        "type": "object",
        "properties": {
          "tenant": {"type": "string"},
          "as_of": {"type": "string", "format": "date-time"},
          "stages": {"type": "array", "items": {
            "type": "object",
            "properties": {
              "stage": {"type": "string"},
              "currency": {"type": "string"},
              "deals": {"type": "integer"},
              "amount": {"type": "integer", "format": "int64", "description": "Minor units, added up exactly"}
            }
          }}
        },
        "required": ["tenant", "as_of", "stages"]
      },
      "Leaderboard": {
        "type": "object",
        "properties": {
          "tenant": {"type": "string"},
          "currency": {"type": "string"},
          "leaders": {"type": "array", "items": {
            "type": "object",
            "properties": {
              "owner_id": {"type": "string"},
              "display_name": {"type": "string"},
              "won": {"type": "integer"},
              "amount": {"type": "integer", "format": "int64"}
            }
          }}
        },
        "required": ["tenant", "currency", "leaders"]
      },
      "RevenueList": {
        "type": "object",
        "properties": {
          "revenue": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "currency": {"type": "string"},
                "deals": {"type": "integer", "format": "int64"},
                "amount": {"type": "integer", "format": "int64", "description": "Minor units, added up exactly"}
              },
              "required": ["currency", "deals", "amount"]
            }
          }
        },
        "required": ["revenue"]
      },
      "WebhookDeliveries": {
        "type": "object",
        "properties": {
          "deliveries": {"type": "array", "items": {
            "type": "object",
            "properties": {
              "tenant_id": {"type": "string"},
              "event_id": {"type": "string"},
              "event_type": {"type": "string"},
              "status": {"type": "string", "enum": ["pending", "delivered", "failed"]},
              "attempts": {"type": "integer"},
              "response_code": {"type": "integer"},
              "updated_at": {"type": "string", "format": "date-time"}
            }
          }}
        }
      },
      "Error": {
        "type": "object",
        "properties": {"error": {"type": "string"}},
        "required": ["error"]
      }
    }
  }
}
