{
  "openapi": "3.1.0",
  "info": {"title": "crm-host deals", "version": "0.1.0"},
  "paths": {
    "/deals": {
      "get": {
        "summary": "List the tenant's deals, newest first, with their stage and owner names",
        "parameters": [
          {"$ref": "#/components/parameters/Tenant"},
          {"name": "stage", "in": "query", "schema": {"type": "string"}},
          {"name": "owner", "in": "query", "schema": {"type": "string"}},
          {"name": "account", "in": "query", "schema": {"type": "string"}},
          {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 200}}
        ],
        "responses": {
          "200": {"description": "The deals the filters match", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DealList"}}}}
        }
      },
      "post": {
        "summary": "Create a deal; with an Idempotency-Key, a repeated request answers the first one's response",
        "parameters": [
          {"$ref": "#/components/parameters/Tenant"},
          {"name": "Idempotency-Key", "in": "header", "schema": {"type": "string", "maxLength": 255}}
        ],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DealCreation"}}}},
        "responses": {
          "201": {"description": "The deal; a replay carries Idempotent-Replayed: true", "headers": {"ETag": {"schema": {"type": "string"}}},
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Deal"}}}},
          "403": {"description": "A viewer does not write deals", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "409": {"description": "The identifier is taken, by a deal or by a deleted deal that keeps it, or a request with this key is still being answered", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "422": {"description": "A value is not accepted, the stage is not one of the tenant's, the account is not one of its live accounts, the owner is not a member, or the key was used with another body", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/deals/{id}": {
      "get": {
        "summary": "Read a deal; its ETag is its version",
        "parameters": [{"$ref": "#/components/parameters/Tenant"}, {"$ref": "#/components/parameters/DealID"}],
        "responses": {
          "200": {"description": "The deal", "headers": {"ETag": {"schema": {"type": "string"}}},
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Deal"}}}},
          "404": {"description": "The tenant has no deal with this identifier", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      },
      "patch": {
        "summary": "Change a deal at the version If-Match names",
        "parameters": [
          {"$ref": "#/components/parameters/Tenant"}, {"$ref": "#/components/parameters/DealID"}, {"$ref": "#/components/parameters/IfMatch"}
        ],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DealChange"}}}},
        "responses": {
          "200": {"description": "The deal as changed", "headers": {"ETag": {"schema": {"type": "string"}}},
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Deal"}}}},
          "404": {"description": "The tenant has no deal with this identifier", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "412": {"description": "The deal is not at the version If-Match names", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "422": {"description": "A value is not accepted, the owner is not a member, or the account is not one of the tenant's live accounts", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "428": {"description": "The request carries no If-Match", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      },
      "delete": {
        "summary": "Remove a deal from the pipeline; its row and its activities stay",
        "parameters": [{"$ref": "#/components/parameters/Tenant"}, {"$ref": "#/components/parameters/DealID"}],
        "responses": {
          "204": {"description": "The deal is removed"},
          "404": {"description": "The tenant has no deal with this identifier", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/deals/{id}/stage": {
      "post": {
        "summary": "Move a deal to another of the tenant's stages at the version If-Match names; the move and its activity commit together",
        "parameters": [
          {"$ref": "#/components/parameters/Tenant"}, {"$ref": "#/components/parameters/DealID"}, {"$ref": "#/components/parameters/IfMatch"}
        ],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {
          "type": "object", "properties": {"stage": {"type": "string"}, "note": {"type": "string"}}, "required": ["stage"]
        }}}},
        "responses": {
          "200": {"description": "The deal as moved and the activity recording the move", "content": {"application/json": {"schema": {
            "type": "object", "properties": {"deal": {"$ref": "#/components/schemas/Deal"}, "activity": {"type": "object"}}, "required": ["deal", "activity"]
          }}}},
          "404": {"description": "The tenant has no deal with this identifier", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "409": {"description": "The deal is already in this stage", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "412": {"description": "The deal is not at the version If-Match names", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "422": {"description": "The stage is not one of the tenant's", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "428": {"description": "The request carries no If-Match", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/deals/{id}/stakeholders": {
      "put": {
        "summary": "Replace the contacts a deal names as its stakeholders; an empty list clears them. The deal's version does not move",
        "parameters": [{"$ref": "#/components/parameters/Tenant"}, {"$ref": "#/components/parameters/DealID"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {
          "type": "object", "properties": {"contact_ids": {"type": "array", "items": {"type": "string"}, "maxItems": 50}}, "required": ["contact_ids"]
        }}}},
        "responses": {
          "200": {"description": "The deal with its stakeholders as replaced", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Deal"}}}},
          "403": {"description": "A viewer does not write deals", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "404": {"description": "The tenant has no deal with this identifier", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "422": {"description": "The list is missing, too long or names an empty identifier, or a contact is not one of the tenant's live contacts", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      },
      "post": {
        "summary": "Add one contact to a deal's stakeholders; adding one already there changes nothing. The deal's version does not move",
        "parameters": [{"$ref": "#/components/parameters/Tenant"}, {"$ref": "#/components/parameters/DealID"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {
          "type": "object", "properties": {"contact_id": {"type": "string"}}, "required": ["contact_id"]
        }}}},
        "responses": {
          "200": {"description": "The deal with its stakeholders", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Deal"}}}},
          "403": {"description": "A viewer does not write deals", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "404": {"description": "The tenant has no deal with this identifier", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "422": {"description": "The contact is empty or not one of the tenant's live contacts", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/deals/{id}/stakeholders/{contact}": {
      "delete": {
        "summary": "Remove one contact from a deal's stakeholders, whether or not it was one. The deal's version does not move",
        "parameters": [
          {"$ref": "#/components/parameters/Tenant"}, {"$ref": "#/components/parameters/DealID"}, {"$ref": "#/components/parameters/StakeholderContact"}
        ],
        "responses": {
          "204": {"description": "The contact is not among the deal's stakeholders"},
          "403": {"description": "A viewer does not write deals", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "404": {"description": "The tenant has no deal with this identifier", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Tenant": {"name": "X-Tenant", "in": "header", "required": true, "schema": {"type": "string"}, "description": "The alias of the tenant the request is scoped to"},
      "DealID": {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}},
      "StakeholderContact": {"name": "contact", "in": "path", "required": true, "schema": {"type": "string"}, "description": "The identifier of one of the tenant's contacts"},
      "IfMatch": {"name": "If-Match", "in": "header", "required": true, "schema": {"type": "string"}, "description": "The deal's ETag, as a read answered it"}
    },
    "schemas": {
      "DealCreation": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "account_id": {"type": "string", "description": "A live account of the tenant"},
          "title": {"type": "string"},
          "amount": {"type": "integer", "format": "int64", "minimum": 0, "description": "In the currency's minor units"},
          "currency": {"type": "string", "pattern": "^[A-Z]{3}$", "description": "The tenant's deals.default-currency setting when left out"},
          "stage": {"type": "string"},
          "owner_id": {"type": "string", "description": "The caller when left out; a member of the tenant"},
          "expected_close": {"type": "string", "format": "date"}
        },
        "required": ["account_id", "title", "amount", "stage"]
      },
      "DealChange": {
        "type": "object",
        "properties": {
          "title": {"type": "string"},
          "account_id": {"type": "string"},
          "amount": {"type": "integer", "format": "int64", "minimum": 0},
          "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
          "owner_id": {"type": "string"},
          "expected_close": {"type": "string", "format": "date"}
        }
      },
      "Deal": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "account_id": {"type": "string"},
          "account_name": {"type": "string", "description": "The account's name; empty once the account is deleted"},
          "title": {"type": "string"},
          "amount": {"type": "integer", "format": "int64"},
          "currency": {"type": "string"},
          "stage": {"type": "string"},
          "stage_name": {"type": "string"},
          "stage_kind": {"type": "string"},
          "owner_id": {"type": "string"},
          "owner_name": {"type": "string"},
          "version": {"type": "integer"},
          "expected_close": {"type": ["string", "null"], "format": "date"},
          "closed_at": {"type": ["string", "null"], "format": "date-time"},
          "created_at": {"type": "string", "format": "date-time"},
          "updated_at": {"type": "string", "format": "date-time"},
          "stakeholders": {"type": "array", "description": "The live contacts the deal names, by name", "items": {
            "type": "object", "properties": {"contact_id": {"type": "string"}, "name": {"type": "string"}}, "required": ["contact_id", "name"]
          }}
        },
        "required": ["id", "account_id", "title", "amount", "currency", "stage", "owner_id", "version", "stakeholders"]
      },
      "DealList": {
        "type": "object",
        "properties": {"total": {"type": "integer"}, "deals": {"type": "array", "items": {"$ref": "#/components/schemas/Deal"}}},
        "required": ["total", "deals"]
      },
      "Error": {
        "type": "object",
        "properties": {"error": {"type": "string"}},
        "required": ["error"]
      }
    }
  }
}
