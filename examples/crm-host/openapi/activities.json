{
  "openapi": "3.1.0",
  "info": {"title": "crm-host activities", "version": "0.1.0"},
  "paths": {
    "/activities": {
      "post": {
        "summary": "Record a note, a call, an email or a meeting on one of the tenant's deals",
        "parameters": [{"$ref": "#/components/parameters/Tenant"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {
          "type": "object",
          "properties": {
            "id": {"type": "string"},
            "subject_kind": {"type": "string", "enum": ["deal"]},
            "subject_id": {"type": "string"},
            "kind": {"type": "string", "enum": ["note", "call", "email", "meeting"]},
            "body": {"type": "string", "maxLength": 4000},
            "occurred_at": {"type": "string", "format": "date-time"}
          },
          "required": ["subject_kind", "subject_id", "kind", "body"]
        }}}},
        "responses": {
          "201": {"description": "The activity", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Activity"}}}},
          "409": {"description": "An activity with this identifier exists", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "422": {"description": "A value is not accepted, or the subject is not one of the tenant's deals", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/activities/{id}": {
      "delete": {
        "summary": "Delete an activity a member recorded; a stage change is not deleted",
        "parameters": [{"$ref": "#/components/parameters/Tenant"}, {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {
          "204": {"description": "The activity is deleted"},
          "404": {"description": "The tenant has no activity with this identifier", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "409": {"description": "The activity is a stage change", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/deals/{id}/timeline": {
      "get": {
        "summary": "A deal's activities in the order they occurred",
        "parameters": [{"$ref": "#/components/parameters/Tenant"}, {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {
          "200": {"description": "The timeline", "content": {"application/json": {"schema": {
            "type": "object",
            "properties": {"deal_id": {"type": "string"}, "activities": {"type": "array", "items": {"$ref": "#/components/schemas/Activity"}}},
            "required": ["deal_id", "activities"]
          }}}},
          "404": {"description": "The tenant has no deal with this identifier", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Tenant": {"name": "X-Tenant", "in": "header", "required": true, "schema": {"type": "string"}, "description": "The alias of the tenant the request is scoped to"}
    },
    "schemas": {
      "Activity": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "subject_kind": {"type": "string"},
          "subject_id": {"type": "string"},
          "kind": {"type": "string", "enum": ["note", "call", "email", "meeting", "stage-change"]},
          "body": {"type": "string"},
          "actor_id": {"type": "string"},
          "occurred_at": {"type": "string", "format": "date-time"},
          "event_id": {"type": ["string", "null"], "description": "On a stage change, the identifier of the deal.stage-changed event the move published"},
          "won_event_id": {"type": ["string", "null"], "description": "On a move to a won stage, the identifier of the deal.won event"}
        },
        "required": ["id", "subject_kind", "subject_id", "kind", "body", "actor_id", "occurred_at"]
      },
      "Error": {
        "type": "object",
        "properties": {"error": {"type": "string"}},
        "required": ["error"]
      }
    }
  }
}
