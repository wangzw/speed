{
  "openapi": "3.1.0",
  "info": {"title": "crm-host stage flow", "version": "0.1.0"},
  "paths": {
    "/pipeline/flow": {
      "get": {
        "summary": "How many of the tenant's deals moved from one stage to another",
        "parameters": [{"$ref": "#/components/parameters/Tenant"}],
        "responses": {
          "200": {"description": "One line for each two stages a deal of the tenant moved between", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/FlowList"}}}},
          "403": {"description": "The caller is not a member of the tenant", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Tenant": {"name": "X-Tenant", "in": "header", "required": true, "schema": {"type": "string"}, "description": "The alias of the tenant the request is scoped to"}
    },
    "schemas": {
      "FlowList": {
        "type": "object",
        "properties": {
          "flow": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "from_stage": {"type": "string"},
                "to_stage": {"type": "string"},
                "moves": {"type": "integer", "format": "int64"}
              },
              "required": ["from_stage", "to_stage", "moves"]
            }
          }
        },
        "required": ["flow"]
      },
      "Error": {
        "type": "object",
        "properties": {"error": {"type": "string"}},
        "required": ["error"]
      }
    }
  }
}
