{
  "openapi": "3.1.0",
  "info": {"title": "crm-host memberships", "version": "0.1.0"},
  "paths": {
    "/members": {
      "get": {
        "summary": "List the members of the tenant the request names",
        "parameters": [{"$ref": "#/components/parameters/Tenant"}],
        "responses": {
          "200": {"description": "The tenant's members", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MemberList"}}}},
          "403": {"description": "The caller is not a member of the tenant", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      },
      "post": {
        "summary": "Grant an existing user a role in the tenant the request names; an owner or an admin only",
        "parameters": [{"$ref": "#/components/parameters/Tenant"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Grant"}}}},
        "responses": {
          "200": {"description": "The membership", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Membership"}}}},
          "403": {"description": "The caller may not grant in this tenant", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "404": {"description": "No user has the email", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "422": {"description": "The email is empty or the role is not one of the four", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Tenant": {"name": "X-Tenant", "in": "header", "required": true, "schema": {"type": "string"}, "description": "The alias of the tenant the request is scoped to"}
    },
    "schemas": {
      "Role": {"type": "string", "enum": ["owner", "admin", "rep", "viewer"]},
      "Grant": {
        "type": "object",
        "properties": {"email": {"type": "string"}, "role": {"$ref": "#/components/schemas/Role"}},
        "required": ["email", "role"]
      },
      "Membership": {
        "type": "object",
        "properties": {"tenant_id": {"type": "string"}, "user_id": {"type": "string"}, "role": {"$ref": "#/components/schemas/Role"}},
        "required": ["tenant_id", "user_id", "role"]
      },
      "MemberList": {
        "type": "object",
        "properties": {
          "tenant": {"type": "string"},
          "caller": {"type": "string"},
          "role": {"$ref": "#/components/schemas/Role"},
          "members": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "user_id": {"type": "string"},
                "email": {"type": "string"},
                "display_name": {"type": "string"},
                "role": {"$ref": "#/components/schemas/Role"}
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {"error": {"type": "string"}},
        "required": ["error"]
      }
    }
  }
}
