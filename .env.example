# Local development overrides for the demo program.

# A value set here reaches every command mise runs, `make check`'s test
# processes included. Credentials and values the tests assert against belong
# in local.yaml, which a test's --config leaves unused.

# The primary configuration source when no --config is given.
# DEMO_CONFIG=file:local.yaml

# The SQLite file and the root key that seals encrypted columns. Rotating the
# key on an existing database makes its sealed columns unreadable.
# DEMO_DB__SQLITE__DSN=./var/demo.db
# DEMO_DB__SQLITE__ENCRYPTION_KEY=dev-only-change-me-0123456789abcdef

# The listener address. One listener carries every endpoint, ops probes
# included. A container: the JSON replaces the whole listener set; a local
# run's guards refuse a non-loopback host.
# DEMO_HTTP__LISTENERS={"backend":{"address":"127.0.0.1:8081"}}

# The CORS policy table, which only the primary config source accepts; a
# variable set for it has no effect, and the startup diagnostic names both.

# The origin the run is reached at. The token issuer, the WebAuthn relying
# party and the authentication gateway's trusted origins are bound to it.
# DEMO_AUTHN__GATE__MOUNT__PUBLIC_URL=http://localhost:8081

# The access-token signing key, generated at this path on the first run.
# DEMO_AUTHN__TOKEN__SIGNING_KEY_FILE=var/token-signing-key.pem

# The object store's filesystem root.
# DEMO_OBJECTSTORE__FS__ROOT=./var/objects

# The origins the merged OpenAPI document lists, comma separated.
# DEMO_OPS__SERVERS=http://localhost:8081

# The frontend dev server's port. Unset means 8080; a value that is not a
# port fails the config load, and strictPort fails the start on a taken port.
# DEMO_WEB_PORT=8080

# The origin the dev server proxies the backend namespaces to. Unset means the
# compiled backend listener.
# DEMO_WEB_BACKEND_PROXY=http://127.0.0.1:8081

# The service name the telemetry provider reports.
# DEMO_OBSERVABILITY__OTEL__SERVICE_NAME=demo

# The endpoint the embedded frontend bundle is served on.
# DEMO_WEBUI__ENDPOINT=web

# Social sign-in and the SMS family are configured in local.yaml, whose
# tracked template is local.yaml.example.
# (no variable: only the primary config source may supply them)

# What the first `sqlite seed` writes. Each list is a container replaced whole
# by its JSON value. The settings example opens signup and admits numbers
# beginning +1 and +86, which phone sign-in needs.
# DEMO_SEED__ACCOUNTS=[{"identifier":"operator","password":"operator-dev-secret","display-name":"Demo Operator","platform-admin":true}]
# DEMO_SEED__TENANTS=[{"name":"acme","admins":["operator"]}]
# DEMO_SEED__MEMBERS=[]
# DEMO_SEED__SETTINGS=[{"key":"authn.mfa.sensitive-min-age","value":"1h"},{"key":"authn.sms.allowed-prefixes","value":"[\"+1\",\"+86\"]"},{"key":"authn.account.signup","value":"open"}]
